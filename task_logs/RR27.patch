+}
+
+.primaryButton:hover {
+  filter: brightness(1.1);
+}
+
+.primaryButton:active {
+  transform: translateY(1px);
+}
+
+.primaryButton:disabled {
+  opacity: 0.6;
+  cursor: default;
+}
+
+.ghostButton {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 34px;
+  padding: 0 12px;
+  border-radius: 10px;
+  border: 1px solid var(--border-subtle);
+  background: var(--bg-card);
+  color: var(--text-primary);
+  font-size: 12px;
+  cursor: pointer;
+  transition: background 120ms ease;
+}
+
+.ghostButton:hover {
+  background: var(--bg-card-hover);
+}
+
+.copied {
+  color: var(--success);
+}
+
+.demoBadge {
+  margin-left: auto;
+  font-size: 10px;
+  color: var(--warn-text);
+  border: 1px solid var(--warn);
+  border-radius: 999px;
+  padding: 2px 8px;
+}
+
+/* ── 骨架/空/加载（图5） ───────────────────────────────── */
+.skeleton {
+  border-radius: 6px;
+  background: var(--bg-skeleton);
+  color: transparent;
+  min-height: 12px;
+}
+
+.skeletonBlock {
+  height: 84px;
+  border-radius: 12px;
+}
+
+.loadingBanner {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 16px;
+  border-radius: 12px;
+  border: 1px solid var(--border-strong);
+  background: var(--bg-card);
+}
+
+.loadingSpinner {
+  color: var(--accent-blue);
+  flex: 0 0 auto;
+}
+
+.loadingText {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.loadingTitle {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--accent-blue-bright);
+}
+
+.loadingSub {
+  font-size: 11px;
+  color: var(--text-secondary);
+}
+
+.stateBanner {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 14px;
+  border-radius: 12px;
+  min-width: 0;
+}
+
+.stateBannerError {
+  border: 1px solid color-mix(in srgb, var(--danger) 55%, transparent);
+  background: var(--danger-dim);
+  color: var(--danger-text);
+}
+
+.stateBannerWarn {
+  border: 1px solid color-mix(in srgb, var(--warn) 55%, transparent);
+  background: var(--warn-dim);
+  color: var(--warn-text);
+}
+
+.stateBannerEmpty {
+  border: 1px solid var(--border-subtle);
+  background: var(--bg-card);
+  color: var(--text-primary);
+}
+
+.stateIcon {
+  flex: 0 0 auto;
+}
+
+.stateBody {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+  min-width: 0;
+  flex: 1 1 auto;
+}
+
+.stateTitle {
+  font-size: 13px;
+  font-weight: 700;
+}
+
+.stateSub {
+  font-size: 11px;
+  color: var(--text-secondary);
+  overflow-wrap: anywhere;
+}
+
+.stateAction {
+  flex: 0 0 auto;
+}
+
+.mutedNote {
+  font-size: 11px;
+  color: var(--text-secondary);
+  overflow-wrap: anywhere;
+}
+
+.hidden {
+  display: none;
+}
+
+.titleSubPlan {
+  font-size: 10px;
+  color: var(--text-tertiary);
+  font-weight: 600;
+}
