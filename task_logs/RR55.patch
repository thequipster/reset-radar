+    expect(after.filter(row => row.kind === 'weekday_experiment' && row.record?.modelVersion === WEEKDAY_VERSION)).toHaveLength(1);
+    expect(after.filter(row => row.kind === 'prediction' && row.group === 'primary_daily' &&
