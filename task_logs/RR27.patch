+// RR27 域测试：展示层格式化（北京时区显式格式化；null/0 严格区分）。期望值手算：
+// 2026-10-11T16:26:37Z = 北京 2026-10-12 00:26:37（跨日，UTC+8 无夏令时，D004）。
+import { describe, expect, it } from "vitest";
+import {
+  beijingFull, beijingShort, creditsLabel, daysLabel, deltaPct, percent1, percentWhole, weekdayDateLabel,
+} from "../format";
+
+describe("北京时区格式化（禁止截 ISO 串）", () => {
+  it("跨日：UTC 16:26 → 北京次日 00:26；短格式含日期", () => {
+    expect(beijingShort("2026-10-11T16:26:37Z")).toBe("10/12 00:26");
+    expect(beijingFull("2026-10-11T16:26:37Z")).toBe("2026/10/12 00:26:37");
+  });
+  it("同日：UTC 03:05 → 北京 11:05", () => {
+    expect(beijingShort("2026-10-11T03:05:00Z")).toBe("10/11 11:05");
+  });
+  it("空/非法输入返回 null，不输出误导性日期", () => {
+    expect(beijingShort(null)).toBeNull();
+    expect(beijingShort("")).toBeNull();
+    expect(beijingShort("not-a-date")).toBeNull();
+    expect(beijingFull(undefined)).toBeNull();
+  });
+});
+
+describe("null 与 0 严格区分（02-spec §6）", () => {
+  it("百分比：null→“—”；0→“0%”；一位小数口径同", () => {
+    expect(percentWhole(null)).toBe("—");
+    expect(percentWhole(0)).toBe("0%");
+    expect(percentWhole(29.4)).toBe("29%");
+    expect(percent1(null)).toBe("—");
+    expect(percent1(25.44)).toBe("25.4%");
+  });
+  it("卡数：null→“卡 —”；0→“卡 ×0”；3→“卡 ×3”", () => {
+    expect(creditsLabel(null)).toBe("卡 —");
+    expect(creditsLabel(0)).toBe("卡 ×0");
+    expect(creditsLabel(3)).toBe("卡 ×3");
+  });
+  it("delta：正负号与图稿一致（非 ASCII 减号）", () => {
+    expect(deltaPct(8.74)).toBe("+8.7");
+    expect(deltaPct(-1.24)).toBe("−1.2");
+    expect(deltaPct(0)).toBe("+0.0");
+  });
+  it("天数：一位小数；null→“—”", () => {
+    expect(daysLabel(2.44)).toBe("2.4 天");
+    expect(daysLabel(null)).toBe("—");
+  });
+});
+
+describe("weekdayDateLabel（候选日轴标签）", () => {
+  it("北京日历键 → 周X MM/DD", () => {
+    // 2026-10-15=周四（与 calibration.core 周锚同源：10-12=周一）。
+    expect(weekdayDateLabel("2026-10-15")).toBe("周四 10/15");
+    expect(weekdayDateLabel("2026-10-11")).toBe("周日 10/11");
+  });
+  it("非法键原样返回不炸", () => {
+    expect(weekdayDateLabel("garbage")).toBe("garbage");
+  });
+});
diff --git a/src/ui/__tests__/ui.theme.test.ts b/src/ui/__tests__/ui.theme.test.ts
new file mode 100644
index 0000000..6e4674b
--- /dev/null
+++ b/src/ui/__tests__/ui.theme.test.ts
@@ -0,0 +1,88 @@
+// RR27 域测试：主题偏好解析/记忆 + widget.css 双主题 token 存在性（CSS 是 token 唯一源，
+// 此处以文件内容断言防漂移——token 丢失会整块 UI 掉色）。
+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  THEME_STORAGE_KEY, initialThemeOverride, readThemePreference, resolveTheme, writeThemePreference,
+} from "../theme";
+
+function memoryStore(initial: Record<string, string> = {}) {
+  const map = new Map(Object.entries(initial));
+  return {
+    getItem: (k: string) => map.get(k) ?? null,
+    setItem: (k: string, v: string) => void map.set(k, v),
+    removeItem: (k: string) => void map.delete(k),
+  } as Storage;
+}
+
+describe("initialThemeOverride（?theme= 截图入口）", () => {
+  it("dark/light 生效；非法/缺失返回 null", () => {
+    expect(initialThemeOverride("?theme=dark")).toBe("dark");
+    expect(initialThemeOverride("?theme=light")).toBe("light");
+    expect(initialThemeOverride("?a=1&theme=light&b=2")).toBe("light");
+    expect(initialThemeOverride("")).toBeNull();
+    expect(initialThemeOverride("?theme=neon")).toBeNull();
+    expect(initialThemeOverride("?themes=light")).toBeNull(); // 前缀相似不误匹配
+  });
+});
+
+describe("resolveTheme", () => {
+  it("dark/light 直选；system 跟随系统深浅", () => {
+    expect(resolveTheme("dark", false)).toBe("dark");
+    expect(resolveTheme("light", true)).toBe("light");
+    expect(resolveTheme("system", true)).toBe("dark");
+    expect(resolveTheme("system", false)).toBe("light");
+  });
+});
+
+describe("本地记忆（localStorage）", () => {
+  it("合法值往返；坏值/无存储回退 dark；写失败不抛错", () => {
+    const store = memoryStore({ [THEME_STORAGE_KEY]: "light" });
+    expect(readThemePreference(store)).toBe("light");
+    expect(writeThemePreference(store, "system")).toBe(true);
+    expect(readThemePreference(store)).toBe("system");
+    expect(readThemePreference(memoryStore())).toBe("dark"); // 默认=图3 深色主参考
+    expect(readThemePreference(memoryStore({ [THEME_STORAGE_KEY]: "neon" }))).toBe("dark");
+    // 抛错存储（如隐私模式配额）：读写都不炸。
+    const throwing = {
+      length: 0,
+      clear: () => {},
+      key: () => null,
+      removeItem: () => {},
+      getItem: () => {
+        throw new Error("quota");
+      },
+      setItem: () => {
+        throw new Error("quota");
+      },
+    } as unknown as Storage;
+    expect(readThemePreference(throwing)).toBe("dark");
+    expect(writeThemePreference(throwing, "light")).toBe(false);
+    expect(readThemePreference(null)).toBe("dark");
+  });
+});
+
+describe("widget.css token 完整性（双主题）", () => {
+  const css = readFileSync(
+    join(fileURLToPath(new URL("../", import.meta.url)), "widget.css"),
+    "utf8",
+  );
+  const tokens = [
+    "--bg-panel", "--bg-card", "--bg-skeleton", "--ring-track", "--border-subtle",
+    "--text-primary", "--text-secondary", "--accent-blue", "--accent-cyan", "--accent-purple",
+    "--success", "--warn", "--danger", "--glow-purple", "--shadow-panel",
+  ];
+  it.each(tokens)("深色块含 %s", (token) => {
+    const darkBlock = css.slice(css.indexOf(":root"), css.indexOf('[data-theme="light"]'));
+    expect(darkBlock).toContain(`${token}:`);
+  });
+  it.each(tokens)("浅色块含 %s", (token) => {
+    const lightBlock = css.slice(css.indexOf('[data-theme="light"]'));
+    expect(lightBlock).toContain(`${token}:`);
+  });
+  it("reduced-motion 关停旋转/位移动效（02-spec §5）", () => {
+    expect(css).toContain("prefers-reduced-motion: reduce");
+  });
+});
