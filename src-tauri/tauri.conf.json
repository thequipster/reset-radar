{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reset-radar",
  "version": "0.1.0",
  "identifier": "app.resetradar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "重置雷达 reset-radar",
        "width": 420,
        "height": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Codex reset risk & usage planner",
    "longDescription": "看得见准头的 Codex 重置风险与用卡规划器（本地优先，持续校准自己的预测）。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
