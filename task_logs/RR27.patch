@@ -0,0 +1,43 @@
+// RR27：复制摘要文本（02-spec §2「输出单位、模型标签、时刻与 stale 标记」）。纯函数：
+// 只拼接 VM/摘要既有字段，不重算任何数字；演示模式必须带标识，绝不冒充实跑。
+import type { DashboardViewModel } from "./adapters";
+import type { CalibrationSummaryView } from "../lib";
+import { beijingFull, creditsLabel, percent1, percentWhole } from "./format";
+
+export function buildCopySummary(
+  vm: DashboardViewModel,
+  calibration: CalibrationSummaryView,
+  options: { live: boolean },
+): string {
+  const lines: string[] = [];
+  lines.push(options.live ? "reset-radar 状态摘要" : "reset-radar 状态摘要（演示数据 · 非本机实采）");
+  lines.push(`方案：${vm.provider}${vm.plan != null ? ` · ${vm.plan}` : ""}`);
+  lines.push(`周额度剩余：${percentWhole(vm.remainingPercent)}${vm.shortRemainingPercent != null ? `｜短窗剩余：${percentWhole(vm.shortRemainingPercent)}` : ""}`);
+  lines.push(`重置卡：${creditsLabel(vm.resetCredits)}`);
+  lines.push(`重置风险（未来24h 模型估计）：${vm.risk == null ? "—" : percent1(vm.risk.score)}`);
+  if (vm.dailyPlan != null) {
+    lines.push(`今日建议追加：+${vm.dailyPlan.suggested.toFixed(1)} 个周额度百分点（建议后剩余 ${vm.dailyPlan.suggestedRemaining.toFixed(1)}%）`);
+  }
+  if (vm.cardPlan != null) {
+    lines.push(`用卡建议：今日期望 +${vm.cardPlan.expectedGainTodayPercent.toFixed(1)} pp / 最佳日 +${vm.cardPlan.expectedGainBestPercent.toFixed(1)} pp（${vm.cardPlan.bestDayLocalDate}）`);
+  }
+  const observed = beijingFull(vm.observedAt);
+  lines.push(`额度观测：${observed ?? "—"}（北京时间）`);
+  if (vm.historySource != null && vm.historySource.state !== "fresh") {
+    lines.push(`历史来源：${vm.historySource.state === "stale" ? "已过期" : "无效"}（as_of ${vm.historySource.asOf ?? "—"}）——以上建议基于上次观测`);
+  }
+  if (vm.resetStatus != null && vm.resetStatus.state !== "ok") {
+    lines.push(`公告来源：${vm.resetStatus.state === "stale" ? "已过期" : "失败"}（上次尝试 ${beijingFull(vm.resetStatus.lastAttemptAt) ?? "—"}）`);
+  }
+  if (calibration.status === "ok") {
+    const data = calibration.data;
+    lines.push(
+      data.sampleCount === 0
+        ? "校准：数据积累中（n=0）"
+        : `校准：n=${data.sampleCount}，Brier ${data.brier?.toFixed(3) ?? "—"}，命中率 ${data.hitRate == null ? "—" : `${(data.hitRate * 100).toFixed(1)}%`}（报告时刻 ${beijingFull(data.generatedAt) ?? "—"} 北京时间）`,
+    );
+  } else {
+    lines.push(`校准：${calibration.status === "missing" ? "尚未生成报告" : "报告无效，需重新生成"}`);
+  }
+  return lines.join("\n");
+}
diff --git a/src/ui/demoScenarios.ts b/src/ui/demoScenarios.ts
new file mode 100644
index 0000000..a05a21a
--- /dev/null
+++ b/src/ui/demoScenarios.ts
@@ -0,0 +1,87 @@
+// RR27：演示场景夹具（浏览器预览与状态截图注入用，02-spec §6 末行）。
+// 全部为「演示数据」：数字与生产 VM 无关，界面必须显示演示标识；绝不写入预测日志、
+// 不冒充实跑证据。默认 demo=健康快照（RR08 冒烟实测形态）；异常场景按 hash 注入。
+import type { ProviderSnapshot } from "./types";
+
+function baseSnapshot(overrides: Partial<ProviderSnapshot>): ProviderSnapshot {
+  const now = new Date().toISOString();
+  return {
+    provider: "codex",
+    displayName: "CODEX",
+    plan: "PLUS",
+    weeklyWindow: { remainingPercent: 29, resetsAt: null, windowSeconds: 604_800 },
+    shortWindow: { remainingPercent: 64, resetsAt: null, windowSeconds: 3600 },
+    resetCredits: 3,
+    rateLimitSnapshot: {
+      source: "app-server", usedPercent: 71, windowDurationMins: 10_080,
+      resetsAt: null, observedAt: now,
+    },
+    updatedAt: now,
+    status: "ok",
+    message: null,
+    ...overrides,
+  };
+}
+
+/** 默认演示快照（浏览器 demo 降级用；数值沿 RR09 demo 口径）。 */
+export function demoSnapshot(): ProviderSnapshot {
+  const resetsAt = new Date(
+    Math.ceil((Date.now() + 2 * 86_400_000) / 86_400_000) * 86_400_000,
+  ).toISOString();
+  return baseSnapshot({
+    weeklyWindow: { remainingPercent: 29, resetsAt, windowSeconds: 604_800 },
+    rateLimitSnapshot: {
+      source: "app-server", usedPercent: 71, windowDurationMins: 10_080,
+      resetsAt, observedAt: new Date().toISOString(),
+    },
+  });
+}
+
+export type DemoScenario = "empty" | "error" | "stale" | "credits-zero" | "credits-unknown" | "loading";
+
+export const DEMO_SCENARIOS: readonly DemoScenario[] = [
+  "empty", "error", "stale", "credits-zero", "credits-unknown", "loading",
+];
+
+/** hash → 演示场景（组合段 #demo=empty / #expanded&demo=empty）；无匹配 null。 */
+export function parseDemoScenario(hash: string): DemoScenario | null {
+  for (const segment of hash.replace(/^#/, "").split("&")) {
+    if (!segment.startsWith("demo=")) continue;
+    const value = segment.slice("demo=".length);
+    if ((DEMO_SCENARIOS as readonly string[]).includes(value)) return value as DemoScenario;
+  }
+  return null;
+}
+
+/** 场景 → 注入快照（返回 null 表示该场景无快照，如 loading/empty 由组件按 phase 呈现）。 */
+export function demoScenarioSnapshot(scenario: DemoScenario): ProviderSnapshot | null {
+  const now = new Date().toISOString();
+  switch (scenario) {
+    case "empty":
+      return null; // 空数组：组件显示空态
+    case "error":
+      return baseSnapshot({ status: "error", message: "app-server 连接超时（演示）" });
+    case "stale": {
+      const old = new Date(Date.now() - 26 * 3_600_000).toISOString();
+      return baseSnapshot({
+        updatedAt: old,
+        rateLimitSnapshot: {
+          source: "app-server", usedPercent: 71, windowDurationMins: 10_080,
+          resetsAt: null, observedAt: old,
+        },
+        // 过期展示由数据层状态驱动（02-spec §6）：注入过期公告来源，UI 只映射不判定。
+        resetStatus: {
+          scheduledReset: null, activeWatch: null, latestReset: null,
+          fetchedAt: old, generatedAt: null, freshUntil: old,
+          lastAttemptAt: old, status: "ok", message: null,
+        },
+      });
+    }
+    case "credits-zero":
+      return baseSnapshot({ resetCredits: 0 });
+    case "credits-unknown":
+      return baseSnapshot({ resetCredits: null });
+    case "loading":
+      return null; // 初始化骨架由 phase 呈现
+  }
+}
diff --git a/src/ui/format.ts b/src/ui/format.ts
new file mode 100644
index 0000000..b8d8cb4
--- /dev/null
+++ b/src/ui/format.ts
@@ -0,0 +1,62 @@
+// RR27：展示层格式化（纯函数）。时间一律显式北京时区（02-spec §6：禁止截 ISO 串再标
+// “北京+8”）；null 与 0 严格区分（周余 — vs 0%）。UI 零业务规则：只换算显示，不产生数字。
+
+const BEIJING_TZ = "Asia/Shanghai";
+
+/** ISO 时刻 → 「MM/DD HH:mm」北京时间（跨日含日期；同年省年份）。非法/空返回 null。 */
+export function beijingShort(iso: string | null | undefined): string | null {
+  const ms = Date.parse(iso ?? "");
+  if (!Number.isFinite(ms)) return null;
+  const parts = new Intl.DateTimeFormat("zh-CN", {
+    timeZone: BEIJING_TZ, month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false,
+  }).formatToParts(new Date(ms));
+  const get = (type: string) => parts.find((p) => p.type === type)?.value ?? "";
+  return `${get("month")}/${get("day")} ${get("hour")}:${get("minute")}`;
+}
+
+/** ISO 时刻 → 「YYYY/MM/DD HH:mm:ss」北京时间（完整观测时刻用）。 */
+export function beijingFull(iso: string | null | undefined): string | null {
+  const ms = Date.parse(iso ?? "");
+  if (!Number.isFinite(ms)) return null;
+  const parts = new Intl.DateTimeFormat("zh-CN", {
+    timeZone: BEIJING_TZ, year: "numeric", month: "2-digit", day: "2-digit",
+    hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
+  }).formatToParts(new Date(ms));
+  const get = (type: string) => parts.find((p) => p.type === type)?.value ?? "";
+  return `${get("year")}/${get("month")}/${get("day")} ${get("hour")}:${get("minute")}:${get("second")}`;
+}
+
+/** 北京日历日期键 YYYY-MM-DD → 「周X MM/DD」（候选日轴标签；键本身即北京语义）。 */
+export function weekdayDateLabel(dateKey: string): string {
+  const ms = Date.parse(`${dateKey}T12:00:00Z`);
+  if (!Number.isFinite(ms)) return dateKey;
+  const weekday = new Intl.DateTimeFormat("zh-CN", { timeZone: BEIJING_TZ, weekday: "short" }).format(new Date(ms));
+  const short = beijingShort(new Date(ms).toISOString());
+  return short != null ? `${weekday} ${short.slice(0, 5)}` : dateKey;
+}
+
+/** 0-100 数值 → 整数百分比字符串；null → "—"（不写 0%，02-spec §6 零缺失严格区分）。 */
+export function percentWhole(value: number | null | undefined): string {
+  return value == null || !Number.isFinite(value) ? "—" : `${Math.round(value)}%`;
+}
+
+/** 0-100 数值 → 一位小数百分比；null → "—"。 */
+export function percent1(value: number | null | undefined): string {
+  return value == null || !Number.isFinite(value) ? "—" : `${value.toFixed(1)}%`;
+}
+
+/** 百分点 delta → 带符号一位小数（如 +8.7 / −1.2；非 ASCII 减号与图稿一致）。 */
+export function deltaPct(value: number): string {
+  const sign = value >= 0 ? "+" : "−";
+  return `${sign}${Math.abs(value).toFixed(1)}`;
+}
+
+/** 卡数显示：null → "卡 —"，0 → "卡 ×0"（02-spec §3.2：不照搬 cardPlan.credits 默认零）。 */
+export function creditsLabel(credits: number | null | undefined): string {
+  return credits == null ? "卡 —" : `卡 ×${credits}`;
+}
+
+/** 天数（可小数）→ 一位小数“天”。 */
+export function daysLabel(value: number | null | undefined): string {
+  return value == null || !Number.isFinite(value) ? "—" : `${value.toFixed(1)} 天`;
+}
