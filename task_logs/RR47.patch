+  for (const item of rawItems) {
+    const r = obj(item.raw), id = String(r.id ?? r.eventId ?? r.watchId ?? `${item.kind}:anonymous:${time(r.announcedAt ?? r.announced_at ?? r.fetchedAt) ?? anon++}`);
