+
+describe("§3.3 公开历史与账号历史分用、日级事件", () => {
+  it("来源范围未知的事件不进入账号训练", () => {
+    const risk = assessResetRiskV2({
+      events: [unexpected("u1", T0 - 2 * DAY, { scope: "unknown" })],
