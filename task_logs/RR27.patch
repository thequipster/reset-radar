+  grid-template-columns: repeat(4, 1fr);
+  gap: 6px;
+}
+
+.metricMini {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+  padding: 8px;
+  border-radius: 10px;
+  border: 1px solid var(--border-subtle);
+  background: var(--bg-card);
+  min-width: 0;
+}
+
+.metricMiniLabel {
+  font-size: 10px;
+  color: var(--text-secondary);
+}
+
+.metricMiniValue {
+  font-size: 12px;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+  overflow-wrap: anywhere;
+}
+
+/* ── 候选日柱状图 ──────────────────────────────────────── */
+.chartCard {
+  padding: 10px;
+  border-radius: 12px;
+  border: 1px solid var(--border-subtle);
+  background: var(--bg-card);
+}
+
+.chartTitle {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 11px;
+  color: var(--text-secondary);
+  margin-bottom: 8px;
+}
+
+.chartNote {
+  font-size: 10px;
+  color: var(--text-tertiary);
+  margin-top: 6px;
+}
+
+:global(.outlook-chart) {
+  display: flex;
+  align-items: flex-end;
+  gap: 6px;
+  height: 110px;
+}
+
+:global(.outlook-col) {
+  flex: 1 1 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 3px;
+  min-width: 0;
+  height: 100%;
+}
+
+:global(.outlook-value) {
+  font-size: 10px;
+  font-variant-numeric: tabular-nums;
+  color: var(--text-primary);
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+  white-space: nowrap;
+}
+
+:global(.outlook-value.best) {
+  color: var(--success);
+  font-weight: 700;
+}
+
+:global(.outlook-bar-track) {
+  flex: 1 1 auto;
+  width: 100%;
+  max-width: 30px;
+  display: flex;
+  align-items: flex-end;
+  justify-content: center;
+  border-radius: 4px 4px 0 0;
+}
+
+:global(.outlook-bar) {
+  width: 100%;
+  border-radius: 4px 4px 0 0;
+  background: linear-gradient(180deg, var(--accent-blue-bright), var(--accent-blue-deep));
+}
+
+:global(.outlook-bar.best) {
+  background: linear-gradient(180deg, #34d399, var(--success-deep));
+}
+
+:global(.outlook-axis) {
+  font-size: 9px;
+  color: var(--text-tertiary);
+  text-align: center;
+  white-space: nowrap;
+}
+
+:global(.outlook-axis.best) {
+  color: var(--success);
+  font-weight: 600;
+}
+
+/* ── 底栏：数据与校准 ──────────────────────────────────── */
+.footer {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding-top: 10px;
+  border-top: 1px solid var(--border-subtle);
+  margin-top: 2px;
+}
+
+.dataLines {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.dataLine {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  font-size: 10px;
+  color: var(--text-secondary);
+  min-width: 0;
+}
+
+.dataLineKey {
+  flex: 0 0 auto;
+  color: var(--text-tertiary);
+}
+
+.dataLineValue {
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.dataLineStale {
+  color: var(--warn-text);
+}
+
+.calibrationLine {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  font-size: 11px;
+  min-width: 0;
+}
+
+.calibrationKey {
+  color: var(--text-secondary);
+  flex: 0 0 auto;
+}
+
+.calibrationValue {
+  font-variant-numeric: tabular-nums;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.calibrationZero {
