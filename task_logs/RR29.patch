diff --git a/scripts/contrast-report.mjs b/scripts/contrast-report.mjs
new file mode 100644
index 0000000..c95a259
--- /dev/null
+++ b/scripts/contrast-report.mjs
@@ -0,0 +1,50 @@
+// RR29：对比度核验报告渲染壳（RUNBOOK §9 artifact 口径）。经 node ≥22.18 原生
+// type-stripping 直载 src/ui/*.ts（import 链带 .ts 扩展，同 calibrate.mjs 口径）。
+// 用法：node scripts/contrast-report.mjs > docs/a11y-contrast-20261011.md
+// （脚本只写 stdout；数值唯一源=src/ui/contrastPairs.ts，与域测试快照互锁。）
+import { CONTRAST_PAIRS, pairRatio } from "../src/ui/contrastPairs.ts";
+import { levelThreshold } from "../src/ui/contrast.ts";
+
+const NOW = new Date();
+const stamp = `${NOW.getFullYear()}-${String(NOW.getMonth() + 1).padStart(2, "0")}-${String(NOW.getDate()).padStart(2, "0")}`;
+
+const lines = [];
+lines.push(`# 可访问性对比度核验报告（${stamp}）`);
+lines.push("");
+lines.push("> 生成：\`node scripts/contrast-report.mjs > docs/a11y-contrast-20261011.md\`（RR29，G1 口径）。");
+lines.push("> 计算=WCAG 2.x 相对亮度法；档位：正文 4.5:1，大字（≥24px 或 ≥18.66px 粗体）与图形组件 3:1（1.4.11）。");
+lines.push("> 口径：bg-panel(α0.97) 按不透明近似；*-dim(α0.10–0.12) 合成到所在卡片 bg-card；");
+lines.push("> 横幅渐变三色 a/b/c 各一行。数值唯一源=src/ui/contrastPairs.ts（域测试 84 组快照锁定）。");
+lines.push("");
+
+for (const theme of ["dark", "light"]) {
+  const rows = CONTRAST_PAIRS.map((p) => ({ p, r: pairRatio(p, theme) }));
+  const fail = rows.filter((x) => x.r + 1e-9 < levelThreshold(x.p.level));
+  lines.push(`## ${theme === "dark" ? "深色主题" : "浅色主题"}（${rows.length} 组，不达标 ${fail.length}）`);
+  lines.push("");
+  lines.push("| id | 前景 | 背景（自底向上） | 档位 | 数值 | 结论 |");
+  lines.push("|---|---|---|---|---|---|");
+  for (const { p, r } of rows) {
+    const ok = r + 1e-9 >= levelThreshold(p.level);
+    lines.push(
+      `| ${p.id} | \`${p.fg}\` | ${p.bgStack.map((b) => `\`${b}\``).join(" ⊕ ")} | ${p.level}(${levelThreshold(p.level)}) | **${r.toFixed(2)}** | ${ok ? "达标" : "不达标"} |`,
+    );
+  }
+  lines.push("");
+  lines.push(`小结：${fail.length === 0 ? "全部达标。" : `不达标 ${fail.length} 组：${fail.map((f) => `\`${f.p.id}\`(${f.r.toFixed(2)})`).join("、")}。逐条定夺见文末。`}`);
+  lines.push("");
+}
+
+lines.push("## 出处索引（配对 → CSS 规则）");
+lines.push("");
+lines.push("| id | 出处 | 注 |");
+lines.push("|---|---|---|");
+for (const p of CONTRAST_PAIRS) {
+  lines.push(`| ${p.id} | ${p.source} | ${p.note ?? ""} |`);
+}
+lines.push("");
+lines.push("## 定夺");
+lines.push("");
+lines.push("（交付时按识图子代理复核结论补写：哪些属真实可读性缺陷立卡修复、哪些属三级文本/");
+lines.push("装饰性元素的设计取舍留档。）");
+process.stdout.write(lines.join("\n") + "\n");
diff --git a/scripts/probe-tab-order.ps1 b/scripts/probe-tab-order.ps1
new file mode 100644
index 0000000..6f4e5eb
--- /dev/null
+++ b/scripts/probe-tab-order.ps1
@@ -0,0 +1,86 @@
+# RR29 Tab 键序探针：起 release app → CDP 两跳导航 → 连发 Tab 键 → 逐次记录
+# document.activeElement（tag/class/aria/text 片段）→ 输出键序清单（stdout）。
+# 用法: pwsh -NoProfile -File probe-tab-order.ps1 <exe路径> <hash如#expanded> [端口=9334] [Tab次数=14]
+# 机制沿 shot-expanded.ps1（B09 机制②/B10 PMv2/两跳导航）；CDP Input.dispatchKeyEvent
+# 直达页面焦点链（等效浏览器级键盘输入；NOACTIVATE 窗口的用户路径=点击激活后 Tab，
+# 页面内焦点遍历一致——口径注记于报告）。
+param(
+  [Parameter(Mandatory)][string]$ExePath,
+  [Parameter(Mandatory)][string]$Hash,
+  [int]$Port = 9334,
+  [int]$Tabs = 14,
+  # 非空时导航后先点击该文字的页签按钮再遍历（如"用卡"→ 页内次级控件入序）
+  [string]$ClickTab = ""
+)
+
+$env:WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS = "--remote-debugging-port=$Port"
+$wd = Split-Path $ExePath
+$proc = Start-Process -FilePath $ExePath -WorkingDirectory $wd -PassThru
+$env:WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS = $null
+
+$page = $null
+foreach ($i in 1..30) {
+  Start-Sleep -Milliseconds 700
+  try {
+    $pages = Invoke-RestMethod "http://127.0.0.1:$Port/json/list" -TimeoutSec 2
+    $page = @($pages | Where-Object { $_.type -eq "page" })[0]
+    if ($page) { break }
+  } catch { }
+}
+if (-not $page) { Stop-Process -Id $proc.Id -Force -ErrorAction SilentlyContinue; throw "CDP endpoint not ready" }
+$base = ($page.url -replace '#.*$', '') -replace '\?.*$', ''
+
+$ws = [System.Net.WebSockets.ClientWebSocket]::new()
+[void]$ws.ConnectAsync([Uri]$page.webSocketDebuggerUrl, [Threading.CancellationToken]::None).GetAwaiter().GetResult()
+$script:id = 0
+function Send-Cdp([string]$method, [string]$paramsJson) {
+  $script:id++
+  $json = '{"id":' + $script:id + ',"method":"' + $method + '","params":' + $paramsJson + '}'
+  $bytes = [Text.Encoding]::UTF8.GetBytes($json)
+  [void]$ws.SendAsync([ArraySegment[byte]]::new($bytes),
+    [System.Net.WebSockets.WebSocketMessageType]::Text, $true,
+    [Threading.CancellationToken]::None).GetAwaiter().GetResult()
+  return $script:id
+}
+function Recv-Until([int]$id) {
+  $buf = New-Object byte[] 262144
+  for ($i = 0; $i -lt 40; $i++) {
+    $res = $ws.ReceiveAsync([ArraySegment[byte]]::new($buf),
+      [Threading.CancellationToken]::None).GetAwaiter().GetResult()
+    $text = [Text.Encoding]::UTF8.GetString($buf, 0, $res.Count)
+    if ($text -match ('"id":' + $id + '[,}]')) { return $text }
+  }
+  throw "cdp response id=$id not seen"
+}
+
+# 两跳导航（same-document hash 变更不重挂 SPA）
+$n1 = Send-Cdp "Page.navigate" '{"url":"about:blank"}'
+Recv-Until $n1 | Out-Null
+$n2 = Send-Cdp "Page.navigate" ('{"url":"' + $base + $Hash + '"}')
+Recv-Until $n2 | Out-Null
+Start-Sleep -Seconds 3   # 等 React 挂载
+if ($ClickTab -ne "") {
+  $cJson = @{ expression = "(() => { const b = [...document.querySelectorAll('button')].find(x => (x.textContent||'').trim() === '" + $ClickTab + "'); if (b) { b.click(); return 'clicked'; } return 'not-found'; })()"; returnByValue = $true } | ConvertTo-Json -Compress
+  $cid = Send-Cdp "Runtime.evaluate" $cJson
+  "click: $(Recv-Until $cid)"
+  Start-Sleep -Milliseconds 500
+}
+
+# 起点：document.activeElement 初始状态
+$n3Json = @{ expression = "JSON.stringify({tag:document.activeElement.tagName,cls:(document.activeElement.className||'').toString().slice(0,60)})"; returnByValue = $true } | ConvertTo-Json -Compress
+$n3 = Send-Cdp "Runtime.evaluate" $n3Json
+"start: $(Recv-Until $n3)"
+
+for ($i = 1; $i -le $Tabs; $i++) {
+  foreach ($t in @("keyDown", "keyUp")) {
+    $kid = Send-Cdp "Input.dispatchKeyEvent" ('{"type":"' + $t + '","key":"Tab","code":"Tab","windowsVirtualKeyCode":9,"nativeVirtualKeyCode":9}')
+    Recv-Until $kid | Out-Null
+  }
+  Start-Sleep -Milliseconds 120
+  $eJson = @{ expression = "JSON.stringify({tag:document.activeElement.tagName,cls:(document.activeElement.className||'').toString().slice(0,70),aria:document.activeElement.getAttribute('aria-label')||'',text:(document.activeElement.textContent||'').trim().slice(0,30)})"; returnByValue = $true } | ConvertTo-Json -Compress
+  $eid = Send-Cdp "Runtime.evaluate" $eJson
+  "tab#$i : $(Recv-Until $eid)"
+}
+$ws.Dispose()
+Stop-Process -Id $proc.Id -Force -ErrorAction SilentlyContinue
+"done: $Tabs tabs dispatched"
diff --git a/scripts/shot-expanded.ps1 b/scripts/shot-expanded.ps1
index 374fcdb..a0d50de 100644
--- a/scripts/shot-expanded.ps1
+++ b/scripts/shot-expanded.ps1
@@ -14,7 +14,9 @@ param(
   # 目标 hash：默认 #expanded（起始展开）；空串=默认胶囊态（两跳重载后仍回胶囊）
   [string]$Hash = "#expanded",
   # RR27：截图前把展开面板滚到底（底栏按钮/校准行在折叠线下方，需滚动佐证可达）
-  [switch]$ScrollBottom
+  [switch]$ScrollBottom,
+  # RR29：导航后先点击该文字的页签按钮（如"用卡"），拍指定页视口（credits-zero 决策卡等）
+  [string]$ClickTab = ""
 )
 
 Add-Type -AssemblyName System.Drawing
@@ -91,6 +93,20 @@ if ($ScrollBottom) {
   Send-Cdp 3 "Runtime.evaluate" '{"expression":"document.querySelector(''[role=main]'').scrollTop = 1e6; ''scrolled''","returnByValue":true}'
   "Scroll: $(Recv-Until 3)"
 }
+if ($ClickTab -ne "") {
+  Start-Sleep -Seconds 4   # 等 React 挂载完成（导航响应早于渲染；3s 偶发未挂载完 not-found）
+  $cJson = @{ expression = "(() => { const b = [...document.querySelectorAll('button')].find(x => (x.textContent||'').trim() === '" + $ClickTab + "'); if (b) { b.click(); return 'clicked'; } return 'not-found'; })()"; returnByValue = $true } | ConvertTo-Json -Compress
+  Send-Cdp 4 "Runtime.evaluate" $cJson
+  $clickRes = Recv-Until 4
+  "ClickTab: $clickRes"
+  if ($clickRes -match "not-found") {   # 单次重试（挂载竞态）
+    Start-Sleep -Seconds 2
+    Send-Cdp 5 "Runtime.evaluate" $cJson
+    $clickRes = Recv-Until 5
+    "ClickTab retry: $clickRes"
+  }
+  Start-Sleep -Milliseconds 600
+}
 $ws.Dispose()
 
 Start-Sleep -Seconds 3   # 等整页加载+快照渲染
diff --git a/src/ui/__tests__/ui.contrast.test.ts b/src/ui/__tests__/ui.contrast.test.ts
new file mode 100644
index 0000000..857de36
--- /dev/null
+++ b/src/ui/__tests__/ui.contrast.test.ts
@@ -0,0 +1,135 @@
+// RR29：对比度核验域测试——公式锚点 / CSS 独有 token 对齐 / 全配对数值快照（84 组
+// =42对×2主题，两位小数锁定防色值漂移）。不达标组合是如实计算结果（见
+// docs/a11y-contrast-20261011.md 定夺），此处锁「数值本身」与「不达标清单」两样。
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { composite, contrastRatio, levelThreshold, parseCssColor, relativeLuminance } from "../contrast";
+import { CONTRAST_PAIRS, CSS_ONLY_TOKENS, CSS_ONLY_TOKENS_LIGHT, pairRatio, resolveToken } from "../contrastPairs";
+
+describe("contrast 公式锚点", () => {
+  it("黑白两极 = 21，同色 = 1", () => {
+    expect(contrastRatio(parseCssColor("#ffffff"), parseCssColor("#000000"))).toBeCloseTo(21, 6);
+    expect(contrastRatio(parseCssColor("#123456"), parseCssColor("#123456"))).toBeCloseTo(1, 6);
+  });
+  it("#767676 on #fff ≈ 4.54（4.5:1 经典边界灰）", () => {
+    expect(contrastRatio(parseCssColor("#767676"), parseCssColor("#ffffff"))).toBeCloseTo(4.54, 2);
+  });
+  it("相对亮度：纯白=1 纯黑=0", () => {
+    expect(relativeLuminance(parseCssColor("#ffffff"))).toBeCloseTo(1, 6);
+    expect(relativeLuminance(parseCssColor("#000000"))).toBeCloseTo(0, 6);
+  });
+  it("parseCssColor 覆盖本项目全集：hex6/hex3/rgb/rgba", () => {
