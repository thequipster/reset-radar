+      setCopied("ok");
+      window.setTimeout(() => setCopied("idle"), 1500); // 原位反馈 1.5s（02-spec §5）
+    };
+    if (navigator.clipboard?.writeText) {
+      navigator.clipboard.writeText(text).then(done, () => setCopied("error"));
+    } else {
+      setCopied("error");
+    }
+  };
+
+  // 高亮：覆盖态显示实际生效主题；正常态 system 时光跟随偏好不好猜，高亮偏好项。
