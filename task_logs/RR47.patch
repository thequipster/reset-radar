diff --git a/src/lib/__tests__/cards.v3.test.ts b/src/lib/__tests__/cards.v3.test.ts
new file mode 100644
index 0000000..dd4fcbf
--- /dev/null
+++ b/src/lib/__tests__/cards.v3.test.ts
@@ -0,0 +1,151 @@
+import { describe, expect, it } from "vitest";
+import {
+  CARD_BUFFER_MS, appendCardVersion, beijingDateKey, cardReminder, createResetCard,
+  emptyPersonalInputs, parseCardExpiry, personalInputsStorageKey, reconcileCardCount, recordCardUse, selectEarliestConfirmedCard,
+  updateCardExpiry, withPersonalInputChange, recordPreferenceFeedback, type ResetCard,
+} from "../v3/cards";
+
+const ms = (value: string) => Date.parse(value);
+
+function card(localId: string, expiry: string | null, precision: "date" | "datetime" | "unknown" = "date"): ResetCard {
+  return createResetCard({
+    localId, label: localId, enteredExpiry: expiry, entryPrecision: precision,
+    now: ms("2026-10-10T00:00:00Z"),
+  });
+}
+
+describe("卡截止按北京时间和操作缓冲解释", () => {
+  it("C14：只录日期时安全截止是当天北京零点，晚间最后查看提前到前一天", () => {
+    const parsed = parseCardExpiry("2026-10-20", "date");
+    expect(parsed.exactExpiryAt).toBeNull();
+    expect(parsed.safeDeadlineAt).toBe(ms("2026-10-19T16:00:00Z"));
+    const item = card("date-only", "2026-10-20");
+    const reminder = cardReminder(item, ms("2026-10-18T00:00:00Z"), ["09:00", "20:00"], true);
+    expect(reminder?.lastActionAt).toBe(ms("2026-10-19T12:00:00Z"));
+  });
+
+  it("C15：精确时间的候选严格早于到期减30分钟，恰好到缓冲线不算可执行", () => {
+    const parsed = parseCardExpiry("2026-10-20T10:00", "datetime");
+    expect(parsed.exactExpiryAt).toBe(ms("2026-10-20T02:00:00Z"));
+    const item = card("exact", "2026-10-20T10:00", "datetime");
+    expect(item.safeDeadlineAt).toBe(item.exactExpiryAt);
+    const reminder = cardReminder(item, ms("2026-10-19T12:00:00Z"), ["09:00", "09:30", "20:00"], true);
+    expect(reminder?.lastActionAt).toBe(ms("2026-10-20T01:00:00Z")); // 北京09:00；09:30恰在缓冲线，严格排除
+    expect(CARD_BUFFER_MS).toBe(30 * 60_000);
+  });
+
+  it("拒绝无效日期与不可能的本地时间", () => {
+    expect(() => parseCardExpiry("2026-02-30", "date")).toThrow();
+    expect(() => parseCardExpiry("2026-10-20T25:00", "datetime")).toThrow();
+    expect(parseCardExpiry(null, "unknown")).toEqual({ exactExpiryAt: null, safeDeadlineAt: null });
+  });
+});
+
+describe("库存与用卡身份", () => {
+  it("C16：日期式保守截止已过但服务端仍有卡时提示补时间，不判过期", () => {
+    const expiredConservatively = card("date-past", "2026-10-10");
+    const result = reconcileCardCount([expiredConservatively], 1);
+    const reminder = cardReminder(expiredConservatively, ms("2026-10-12T00:00:00Z"), ["09:00", "20:00"], true);
+    expect(result.status).toBe("consistent");
+    expect(result.cards[0].card?.state).toBe("available");
+    expect(reminder?.tier).toBe("needs-confirmation");
+  });
+
+  it("精确截止已过也只要求核对，不会自动把卡认定为过期", () => {
+    const past = card("past-exact", "2026-10-10T10:00", "datetime");
+    const now = ms("2026-10-12T00:00:00Z");
+    const result = reconcileCardCount([past], 1);
+    expect(result.cards[0].card?.state).toBe("available");
+    expect(cardReminder(past, now, ["09:00"], true)?.tier).toBe("needs-confirmation");
+  });
+
+  it("C17：先选最早已确认卡；确认记录使用后不会再次选中", () => {
+    const later = card("b-later", "2026-10-25");
+    const earlier = card("a-earlier", "2026-10-22");
+    const inputs = { ...emptyPersonalInputs("acct-a"), cards: [later, earlier] };
+    expect(selectEarliestConfirmedCard(inputs.cards, 2, ms("2026-10-12T00:00:00Z"))?.localId).toBe("a-earlier");
+    const afterUse = recordCardUse(inputs, "a-earlier", ms("2026-10-12T00:00:00Z"), 2);
+    expect(afterUse.useRecords[0].status).toBe("user-recorded");
+    expect(afterUse.cards.find((item) => item.localId === "a-earlier")?.state).toBe("used");
+    expect(selectEarliestConfirmedCard(afterUse.cards, 2, ms("2026-10-12T00:00:00Z"))?.localId).toBe("b-later");
+  });
+
+  it("C18：服务端张数多于台账时补未知截止占位，不编有效期", () => {
+    const result = reconcileCardCount([card("known", "2026-10-25")], 2);
+    expect(result.status).toBe("supplementing");
+    expect(result.placeholderCount).toBe(1);
+    expect(result.planningCount).toBe(2);
+    expect(result.cards[1]).toMatchObject({ placeholder: true, card: null, label: "有效期未录入的服务端卡" });
+  });
+
+  it("C19：服务端张数下降只标冲突，不擅自判定最早卡过期", () => {
+    const cards = [card("one", "2026-10-15"), card("two", "2026-10-20"), card("three", "2026-10-25")];
+    const result = reconcileCardCount(cards, 2);
+    expect(result.status).toBe("conflict");
+    expect(result.prompt).toContain("允许选择“我还不确定”");
+    expect(result.cards.map((item) => item.card?.state)).toEqual(["available", "available", "available"]);
+    expect(selectEarliestConfirmedCard(cards, 2, ms("2026-10-12T00:00:00Z"))).toBeNull();
+  });
+
+  it("用卡记录是用户记录，不会改变服务端张数或调用动作", () => {
+    const inputs = { ...emptyPersonalInputs("acct-a"), cards: [card("used", "2026-10-25")] };
+    const result = recordCardUse(inputs, "used", 1234, 1);
+    expect(result.useRecords).toHaveLength(1);
+    expect(result.useRecords[0]).toMatchObject({ serverCountAtRecord: 1, status: "user-recorded" });
+    expect(result.cardVersions.at(-1)?.after?.state).toBe("used");
+  });
+});
+
+describe("追加版本和临时工作量", () => {
+  it("C20：修改有效期追加新版本，旧版本快照仍保留原截止", () => {
+    const before = card("versioned", "2026-10-22");
+    const history = appendCardVersion([], before.localId, null, before, 10);
+    const updated = updateCardExpiry([before], history, before.localId, "2026-10-24", "date", 20);
+    expect(updated.cards[0].safeDeadlineAt).toBe(parseCardExpiry("2026-10-24", "date").safeDeadlineAt);
+    expect(updated.history).toHaveLength(2);
+    expect(updated.history[0].after?.safeDeadlineAt).toBe(parseCardExpiry("2026-10-22", "date").safeDeadlineAt);
+    expect(updated.history[1].before?.safeDeadlineAt).toBe(updated.history[0].after?.safeDeadlineAt);
+  });
+
+  it("已记录使用的卡修改截止后仍保持已使用；提醒时段恰好到达算最后时机", () => {
+    const initial = card("already-used", "2026-10-22");
+    const used = recordCardUse({ ...emptyPersonalInputs("acct-a"), cards: [initial] }, initial.localId, 15, 1);
+    const updated = updateCardExpiry(used.cards, used.cardVersions, initial.localId, "2026-10-24", "date", 20);
+    expect(updated.cards[0].state).toBe("used");
+
+    const atLastAction = card("at-cutoff", "2026-10-20T10:00", "datetime");
+    const lastActionAt = ms("2026-10-20T01:00:00Z");
+    expect(cardReminder(atLastAction, lastActionAt, ["09:00"], true)?.tier).toBe("last-chance");
+  });
+
+  it("预算版本绑定北京当天，允许超过100个百分点；反馈选择追加版本", () => {
+    const day1 = ms("2026-10-12T15:59:00Z");
+    const day2 = ms("2026-10-12T16:00:00Z");
+    const inputs = withPersonalInputChange(emptyPersonalInputs("acct-a"), "weeklyBudgetPercent", {
+      localDate: beijingDateKey(day1), value: 127.5,
+    }, day1);
+    expect(inputs.weeklyBudgetPercent?.value).toBe(127.5);
+    expect(inputs.weeklyBudgetPercent?.localDate).not.toBe(beijingDateKey(day2));
+    const feedback = recordPreferenceFeedback(inputs, "too-late", day2);
+    expect(feedback.feedback).toEqual([{ choice: "too-late", recordedAt: day2 }]);
+    expect(feedback.inputVersions.at(-1)?.field).toBe("feedback");
+    expect(feedback.version).toBe(inputs.version + 1);
+  });
+
+  it("真实账号各自隔离；未知账号只能落到独立演示分区", () => {
+    expect(personalInputsStorageKey("hash-account-a")).not.toBe(personalInputsStorageKey("hash-account-b"));
+    expect(personalInputsStorageKey(null)).toContain("demo%3Aanonymous");
+    expect(personalInputsStorageKey(null)).not.toBe(personalInputsStorageKey("hash-account-a"));
+  });
+
+  it("C33：很忙只记录到北京当天；跨日后不再作为今日选择", () => {
+    const now = ms("2026-10-12T16:30:00Z"); // 北京 10/13 00:30
+    const inputs = emptyPersonalInputs("acct-a");
+    const changed = withPersonalInputChange(inputs, "workloadToday", { localDate: beijingDateKey(now), level: "busy" }, now);
+    expect(changed.workloadToday).toEqual({ localDate: "2026-10-13", level: "busy" });
+    const nextDay = ms("2026-10-13T16:30:00Z");
+    expect(beijingDateKey(nextDay)).toBe("2026-10-14");
+    expect(changed.preference).toBeNull();
+    expect(changed.inputVersions.at(-1)?.field).toBe("workloadToday");
+  });
+});
diff --git a/src/lib/__tests__/demand.v3.test.ts b/src/lib/__tests__/demand.v3.test.ts
new file mode 100644
index 0000000..7efc50b
--- /dev/null
+++ b/src/lib/__tests__/demand.v3.test.ts
@@ -0,0 +1,99 @@
+import { describe, expect, it } from "vitest";
+import { fitDemandModel, type DemandDay, type WorkloadChoice } from "../v3/demand";
+
+const dateForIndex = (i: number) => new Date(Date.parse("2026-09-03T00:00:00Z") + (i - 1) * 86_400_000).toISOString().slice(0, 10);
+const day = (i: number, patch: Partial<DemandDay> = {}): DemandDay => ({
+  dateKey: dateForIndex(i),
+  weeklyCost: 8 + i,
+  weeklyCoverage: 1,
+  weeklyComplete: true,
+  weeklyLowerBound: false,
+  weeklyCrossedReset: false,
+  shortCost: 2 + i / 2,
+  shortCoverage: 1,
+  shortComplete: true,
+  shortLowerBound: false,
+  shortCrossedReset: false,
+  crossedReset: false,
+  estimated: false,
+  weeklyEstimated: false,
+  shortEstimated: false,
+  capacityConstrained: false,
+  ...patch,
+});
+
+describe("v3 demand fit", () => {
+  it("没有有效日时保持需求和短窗配对未知，不填固定日耗", () => {
+    const result = fitDemandModel([], [], Date.parse("2026-10-01T00:00:00Z"));
+    expect(result.sampleDays).toBe(0);
+    expect(result.status).toBe("learning");
+    expect(result.weekly).toBeNull();
+    expect(result.shortWindowPaired).toBeNull();
+    expect(result.workload.unknown).toMatchObject({ low: null, high: null });
+  });
+
+  it("滚动最多 28 个有效北京日，并保留真实样本数与 7/14 日阶段", () => {
+    const days = Array.from({ length: 35 }, (_, i) => day(i + 1));
+    const result = fitDemandModel(days, [], Date.parse("2026-10-01T00:00:00Z"));
+    expect(result.sampleDays).toBe(28);
+    expect(result.status).toBe("estimated");
+    expect(result.weekly?.median).toBeGreaterThan(0);
+    expect(result.weekly?.p80).toBeGreaterThanOrEqual(result.weekly!.median);
+    expect(result.weekly?.p95).toBeGreaterThanOrEqual(result.weekly!.p80);
+    expect(result.shortWindowPaired?.sampleDays).toBe(28);
+  });
+
+  it("完整日不足 7 时只给初步范围，短窗配对不足时返回 null", () => {
+    const result = fitDemandModel([day(1), day(2), day(3)], [], Date.parse("2026-10-01T00:00:00Z"));
+    expect(result.status).toBe("preliminary");
+    expect(result.sampleDays).toBe(3);
+    expect(result.shortWindowPaired).toBeNull();
+  });
+
+  it("不完整、跨重置、下界与估算日不进入有效日样本", () => {
+    const result = fitDemandModel([
+      day(1), day(2), day(3, { weeklyComplete: false }),
+      day(4, { crossedReset: true, weeklyCrossedReset: true }), day(5, { weeklyLowerBound: true }),
+      day(6, { estimated: true, weeklyEstimated: true }),
+    ], [], Date.parse("2026-10-01T00:00:00Z"));
+    expect(result.sampleDays).toBe(2);
+  });
+
+  it("忙闲标签组少于 7 天回退全体，达到 7 天才独立建分布", () => {
+    const days = Array.from({ length: 14 }, (_, i) => day(i + 1));
+    const choices: WorkloadChoice[] = days.map((sample, i) => ({ dateKey: sample.dateKey, workload: i < 7 ? "busy" : "light" }));
+    const result = fitDemandModel(days, choices, Date.parse("2026-10-01T00:00:00Z"));
+    expect(result.workloadGroups.busy.sampleDays).toBe(7);
+    expect(result.workloadGroups.busy.fallbackToAll).toBe(false);
+    expect(result.workloadGroups.light.sampleDays).toBe(7);
+    const fallback = fitDemandModel(days, choices.slice(0, 6), Date.parse("2026-10-01T00:00:00Z"));
+    expect(fallback.workloadGroups.busy.fallbackToAll).toBe(true);
+  });
+
+  it("忙闲档取经验低中高情景；未知保留范围，不映射固定 10/25/50", () => {
+    const result = fitDemandModel(Array.from({ length: 14 }, (_, i) => day(i + 1)), [], Date.parse("2026-10-01T00:00:00Z"));
+    expect(result.workload.light.value).toBe(result.weekly?.p20);
+    expect(result.workload.normal.value).toBe(result.weekly?.median);
+    expect(result.workload.busy.value).toBe(result.weekly?.p80);
+    expect(result.workload.unknown.low).toBe(result.weekly?.p20);
+    expect(result.workload.unknown.high).toBe(result.weekly?.p80);
+    expect([10, 25, 50]).not.toContain(result.workload.busy.value);
+  });
+
+  it("用户周预算给出 0.5/1/2 压力值但不产生概率权重", () => {
+    const result = fitDemandModel([day(1)], [], Date.parse("2026-10-01T00:00:00Z"), { weeklyBudget: 20 });
+    expect(result.budgetScenarios).toEqual([
+      { multiplier: 0.5, weeklyBudget: 10, probability: null },
+      { multiplier: 1, weeklyBudget: 20, probability: null },
+      { multiplier: 2, weeklyBudget: 40, probability: null },
+    ]);
+  });
+
+  it("今天的临时工作量选择不改写此前日期或长期标签样本", () => {
+    const choices: WorkloadChoice[] = [{ dateKey: "2026-10-01", workload: "busy" }];
+    const result = fitDemandModel(Array.from({ length: 8 }, (_, i) => day(i + 1)), choices, Date.parse("2026-10-01T00:00:00Z"));
+    expect(result.choiceCount).toBe(0); // 今日选择不作为已完成历史样本。
+    expect(result.workload.busy.source).toBe("experience");
+    expect(result.workload.busy.value).not.toBe(50);
+  });
+});
diff --git a/src/lib/__tests__/journal.v3.test.ts b/src/lib/__tests__/journal.v3.test.ts
new file mode 100644
index 0000000..09c41de
--- /dev/null
+++ b/src/lib/__tests__/journal.v3.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it } from "vitest";
+import { classifyOutcome, freezePlanning, freezePrediction, nextSignalVersion, predictionGroupAt, type PredictionRecordV3 } from "../v3/journal";
+
+const input = () => ({ id: "p-1", issuedAt: 100, target: "platform_notice" as const,
+  windowStart: 100, windowEnd: 200, probability: 0.2, modelVersion: "p0-v1", trainingCutoff: 90,
+  inputSnapshotId: "snapshot-1", cardLedgerVersion: "ledger-4", preferenceVersion: "pref-2",
+  featureContributions: [{ key: "baseline", before: 0, after: 0.2 }], assumptions: ["coverage-complete"],
+  evidenceQuality: ["observed"], });
+
+describe("v3 frozen prediction journal", () => {
+  it("freezes all target, version and cutoff inputs needed to reproduce a forecast", () => {
+    const source = input();
+    const row = freezePrediction(source);
+    source.featureContributions[0]!.after = 0.9;
+    source.assumptions.push("changed-later");
+    expect(row).toMatchObject({ target: "platform_notice", modelVersion: "p0-v1", trainingCutoff: 90,
+      inputSnapshotId: "snapshot-1", cardLedgerVersion: "ledger-4", preferenceVersion: "pref-2" });
+    expect(row.featureContributions[0]).toMatchObject({ after: 0.2 });
+    expect(row.assumptions).toEqual(["coverage-complete"]);
+  });
+
+  it("planning journal keeps explicit seed and candidate/selected/alternative summaries", () => {
+    const plan = freezePlanning({ id: "plan-1", predictionId: "p-1", seed: 441, candidates: [{ action: "keep_card", score: 0.4 }],
+      selected: { action: "keep_card" }, alternatives: [{ action: "use_card", difference: 0.1 }], });
+    expect(plan).toEqual({ id: "plan-1", predictionId: "p-1", seed: 441,
+      candidates: [{ action: "keep_card", score: 0.4 }], selected: { action: "keep_card" },
+      alternatives: [{ action: "use_card", difference: 0.1 }] });
+  });
+
+  it("platform label remains scorable after card use; incomplete coverage stays pending", () => {
+    const record = freezePrediction(input());
+    expect(classifyOutcome(record, { completeCoverage: true, platformNotice: true })).toBe("positive");
+    expect(classifyOutcome(record, { completeCoverage: true, platformNotice: true, cardUsedAt: 150 })).toBe("positive");
+    expect(classifyOutcome(record, { completeCoverage: false, platformNotice: false })).toBe("pending");
+    expect(classifyOutcome(record, { completeCoverage: true, platformNotice: false, cardUsedAt: 150 })).toBe("negative");
+  });
+
+  it("account outcome is censored by intervening card use and unknown when evidence is ambiguous", () => {
+    const record = freezePrediction({ ...input(), target: "account_external_reset" as const, probability: null });
+    expect(classifyOutcome(record, { completeCoverage: true, accountReset: "hit", cardUsedAt: 150 })).toBe("censored");
+    expect(classifyOutcome(record, { completeCoverage: true, accountReset: "ambiguous" })).toBe("unknown");
+    expect(classifyOutcome(record, { completeCoverage: false, accountReset: "miss" })).toBe("pending");
+    expect(classifyOutcome(record, { completeCoverage: true, accountReset: "miss" })).toBe("negative");
+  });
+
+  it("demand predictions accept null probability rather than fabricating a risk score", () => {
+    const row: PredictionRecordV3 = freezePrediction({ ...input(), target: "demand", probability: null });
+    expect(row.probability).toBeNull();
+    expect(row.target).toBe("demand");
+  });
+
+  it("starts a new first-seen clock after cancellation while retaining prior episode rows", () => {
+    const first = nextSignalVersion(null, { id: "watch-1", chance: 20 }, "2026-10-12T01:00:00Z")!;
+    const changed = nextSignalVersion(first, { id: "watch-1", chance: 40 }, "2026-10-12T02:00:00Z")!;
+    const cancelled = nextSignalVersion(changed, null, "2026-10-12T03:00:00Z")!;
+    const nextEpisode = nextSignalVersion(cancelled, { id: "watch-2", chance: 20 }, "2026-10-13T01:00:00Z")!;
+    expect(first).toMatchObject({ change: "first_seen", firstSeenAt: "2026-10-12T01:00:00Z" });
+    expect(changed).toMatchObject({ change: "changed", firstSeenAt: first.firstSeenAt });
+    expect(cancelled).toMatchObject({ change: "cancelled", firstSeenAt: first.firstSeenAt, value: null });
+    expect(nextEpisode).toMatchObject({ change: "first_seen", firstSeenAt: "2026-10-13T01:00:00Z" });
+    expect(nextSignalVersion(nextEpisode, { id: "watch-2", chance: 20 }, "2026-10-13T01:05:00Z")).toBeNull();
+  });
+
+  it("creates only one Beijing 09:00 primary per day and keeps other refreshes temporary", () => {
+    const atNine = Date.parse("2026-10-12T01:00:00Z");
+    expect(predictionGroupAt(atNine, false)).toEqual({ group: "primary_daily", groupDate: "2026-10-12" });
+    expect(predictionGroupAt(atNine, true)).toEqual({ group: "temporary" });
+    expect(predictionGroupAt(atNine + 60_000, false)).toEqual({ group: "temporary" });
+  });
+});
