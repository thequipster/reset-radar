 const css = readFileSync(join(__dirname, "..", "DashboardPanel.module.css"), "utf8");
 
-describe("RR38：采集状态卡副文案「·」不悬挂行尾", () => {
-  it("「·」并入 .timeNoWrap 段（整段=「· 时间段 北京时间」）", () => {
