index 0000000..daa5b2b
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,56 @@
+# CI — push/PR 全量门禁 + Windows（MSVC）产物构建（RR02）
+# 借鉴 codex-cockpit .github/workflows/release.yml（MIT）：action 逐 commit-SHA pin、
+# setup-node(cache:npm)、dtolnay/rust-toolchain、swatinem/rust-cache(src-tauri->target)、
+# upload-artifact(if-no-files-found:error)。本机 gnu 产物需带 WebView2Loader.dll（TRUTH B02）
+# 不作发布件，发布以本 CI 的 MSVC 产物为准（DECISIONS D009）。
+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  windows:
+    runs-on: windows-latest
+    timeout-minutes: 60
+    steps:
+      - name: Checkout
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+      - name: Setup Node
+        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version: '24'
+          cache: npm
+      - name: Setup Rust (stable, MSVC)
+        uses: dtolnay/rust-toolchain@89b12181fb390509a0842a86cc55eeb8eb928c1d # stable
+      - name: Rust cache
+        uses: swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
+        with:
+          workspaces: src-tauri -> target
+      - name: Install frontend deps
+        run: npm ci
+      - name: Type check (tsc)
+        run: npx tsc --noEmit
+      - name: Unit tests (vitest)
+        run: npx vitest run
+      - name: Rust check
+        run: cargo check --locked --manifest-path src-tauri/Cargo.toml
+      - name: Build desktop app (tauri)
+        run: npm run tauri build
+      - name: Upload installers
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: windows-x64-installer
+          path: |
+            src-tauri/target/release/bundle/nsis/*.exe
+            src-tauri/target/release/bundle/msi/*.msi
+          if-no-files-found: error
+          retention-days: 7
