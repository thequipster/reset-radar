@@ -0,0 +1,27 @@
+// v3 §1/11：窗口按时长识别，输入未知不填额度/有效期。纯函数不读系统时钟。
+import {beijingDayFloor,DAY_MS} from '../beijing';
+import type {AccountState} from './simulator';
+export interface QuotaWindowInput {remainingPercent:number;resetsAt:string|null;windowSeconds:number}
+export interface AccountSnapshotInput {weeklyWindow:QuotaWindowInput|null;shortWindow:QuotaWindowInput|null;rateLimitSnapshot?:{observedAt:string}|null;updatedAt:string;resetCredits:number|null}
+export function normalizeAccount(snapshot:AccountSnapshotInput):AccountState|null{
+ const windows=[snapshot.weeklyWindow,snapshot.shortWindow].filter((w):w is QuotaWindowInput=>w!=null&&w.windowSeconds>0&&w.resetsAt!=null&&Number.isFinite(Date.parse(w.resetsAt))&&Number.isFinite(w.remainingPercent)).sort((a,b)=>b.windowSeconds-a.windowSeconds);
+ if(windows.length!==2||windows[0]!.windowSeconds<=windows[1]!.windowSeconds)return null;
+ const observedAt=Date.parse(snapshot.rateLimitSnapshot?.observedAt??snapshot.updatedAt);if(!Number.isFinite(observedAt))return null;
+ const convert=(w:QuotaWindowInput)=>({remaining:Math.max(0,Math.min(100,w.remainingPercent)),resetsAt:Date.parse(w.resetsAt!),durationMins:w.windowSeconds/60});
+ return{observedAt,weekly:convert(windows[0]!),short:convert(windows[1]!),availableCardCount:snapshot.resetCredits??0};
+}
+export function buildReviewTimes(now:number,times:readonly string[],confirmed:boolean,horizonDays=42):number[]{
+ const result=[now];if(!confirmed)return result;
+ for(let day=beijingDayFloor(now);day<now+horizonDays*DAY_MS;day+=DAY_MS)for(const time of times){const m=/^([01]\d|2[0-3]):([0-5]\d)$/.exec(time);if(!m)continue;const at=day+Number(m[1])*3_600_000+Number(m[2])*60_000;if(at>now)result.push(at);}
+ return[...new Set(result)].sort((a,b)=>a-b);
+}
+export interface SignalVersionInput {signalKind:'scheduled_reset'|'active_watch';observedAt:string;firstSeenAt:string;change:string;value:unknown}
+export function normalizeSignalVersions(rows:readonly SignalVersionInput[],kind:SignalVersionInput['signalKind']):Record<string,unknown>[] {
+ let previous:Record<string,unknown>|null=null;
+ return rows.filter(h=>h.signalKind===kind).map((h,i)=>{
+  const value=h.value&&typeof h.value==='object'?h.value as Record<string,unknown>:null;
+  const id=value?.id??(h.change==='first_seen'?`${kind}:${h.firstSeenAt}`:previous?.id??`${kind}:${h.firstSeenAt}`);
+  const row=value?{...value,id,firstSeenAt:h.firstSeenAt,version:i+1}:{...previous,id,status:'cancelled',cancelledAt:h.observedAt,firstSeenAt:h.firstSeenAt,version:i+1};
+  previous=row;return row;
+ });
+}
diff --git a/src/lib/v3/journal.ts b/src/lib/v3/journal.ts
new file mode 100644
index 0000000..c48a0c6
--- /dev/null
+++ b/src/lib/v3/journal.ts
@@ -0,0 +1,113 @@
+export type PredictionTargetV3 = "platform_notice" | "account_external_reset" | "demand";
+
+export interface PredictionRecordV3 {
+  id: string;
+  issuedAt: number;
+  target: PredictionTargetV3;
+  windowStart: number;
+  windowEnd: number;
+  probability: number | null;
+  modelVersion: string;
+  trainingCutoff: number;
+  inputSnapshotId: string;
+  cardLedgerVersion: string;
+  preferenceVersion: string;
+  featureContributions: unknown[];
+  assumptions: string[];
+  evidenceQuality: string[];
+}
+
+export interface PlanningJournalRecord {
+  id: string;
+  predictionId: string;
+  seed: number;
+  candidates: unknown[];
+  selected: unknown;
+  alternatives: unknown[];
+}
+
+export type PredictionOutcome = "pending" | "positive" | "negative" | "censored" | "unknown";
+
+export interface SignalVersion<T = unknown> {
+  observedAt: string;
+  firstSeenAt: string;
+  change: "first_seen" | "changed" | "cancelled";
+  value: T | null;
+}
+
+/** First-seen belongs to one active episode; cancellation remains the final row of the old episode. */
+export function nextSignalVersion<T>(
+  previous: SignalVersion<T> | null,
+  value: T | null,
+  observedAt: string,
+): SignalVersion<T> | null {
+  if (previous && JSON.stringify(previous.value) === JSON.stringify(value)) return null;
+  if (!previous && value == null) return null;
+  const newEpisode = previous == null || previous.value == null;
+  return {
+    observedAt,
+    firstSeenAt: newEpisode ? observedAt : previous.firstSeenAt,
+    change: newEpisode ? "first_seen" : value == null ? "cancelled" : "changed",
+    value,
+  };
+}
+
+export function predictionGroupAt(issuedAt: number, hasPrimaryForTargetAndVersion: boolean): {
+  group: "primary_daily" | "temporary";
+  groupDate?: string;
+} {
+  const parts = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit",
+    day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(issuedAt);
+  const part = (type: Intl.DateTimeFormatPartTypes) => parts.find((item) => item.type === type)?.value;
+  const groupDate = `${part("year")}-${part("month")}-${part("day")}`;
+  if (part("hour") === "09" && part("minute") === "00" && !hasPrimaryForTargetAndVersion) {
+    return { group: "primary_daily", groupDate };
+  }
+  return { group: "temporary" };
+}
+
+export interface OutcomeEvidence {
+  completeCoverage: boolean;
+  platformNotice?: boolean;
+  accountReset?: "hit" | "miss" | "unobservable" | "ambiguous";
+  /** User intervention censors account replenishment, but never platform-notice outcomes. */
+  cardUsedAt?: number;
+}
+
+function deepCopy<T>(value: T): T {
+  return JSON.parse(JSON.stringify(value)) as T;
+}
+
+export function freezePrediction(input: PredictionRecordV3): PredictionRecordV3 {
+  if (!input.id || !input.modelVersion || !input.inputSnapshotId || !input.cardLedgerVersion || !input.preferenceVersion) {
+    throw new Error("prediction journal requires stable IDs and versions");
+  }
+  if (![input.issuedAt, input.windowStart, input.windowEnd, input.trainingCutoff].every(Number.isFinite) ||
+      input.windowEnd <= input.windowStart || input.windowStart > input.issuedAt ||
+      (input.probability != null && (!Number.isFinite(input.probability) || input.probability < 0 || input.probability > 1))) {
+    throw new RangeError("prediction journal has an invalid time window or probability");
+  }
+  return deepCopy(input);
+}
+
+export function freezePlanning(input: PlanningJournalRecord): PlanningJournalRecord {
+  if (!input.id || !input.predictionId || !Number.isSafeInteger(input.seed)) {
+    throw new Error("planning journal requires IDs and a reproducible integer seed");
+  }
+  return deepCopy(input);
+}
+
+export function classifyOutcome(record: PredictionRecordV3, evidence: OutcomeEvidence): PredictionOutcome {
+  if (record.target === "demand") return "unknown";
+  if (record.target === "platform_notice") {
+    if (!evidence.completeCoverage) return "pending";
+    return evidence.platformNotice ? "positive" : "negative";
+  }
+  if (evidence.cardUsedAt != null && evidence.cardUsedAt >= record.windowStart && evidence.cardUsedAt <= record.windowEnd) {
+    return "censored";
+  }
+  if (!evidence.completeCoverage) return "pending";
+  if (evidence.accountReset === "hit") return "positive";
+  if (evidence.accountReset === "miss") return "negative";
+  return "unknown";
+}
diff --git a/src/lib/v3/observations.ts b/src/lib/v3/observations.ts
new file mode 100644
index 0000000..2ef671b
--- /dev/null
+++ b/src/lib/v3/observations.ts
@@ -0,0 +1,218 @@
+import { beijingDayFloor, beijingDayKey, DAY_MS } from "../beijing";
+
+export const DEFAULT_MAX_OBSERVATION_GAP_MS = 15 * 60_000;
+
+export interface WindowSnapshotV3 {
+  /** Identity of the provider window; usually its resetsAt value plus a local generation counter. */
+  generation: string;
+  usedPercent: number;
+}
+
+export interface SnapshotV3 {
+  id: string;
+  /** ISO timestamp as persisted; epoch milliseconds are accepted by pure callers. */
+  observedAt: string | number;
+  accountKey: string;
+  sourceVersion: string;
+  weekly: WindowSnapshotV3 | null;
+  short: WindowSnapshotV3 | null;
+  schemaVersion?: 3;
+  rawSnapshot?: unknown;
+}
+
+export interface WindowUsageEvidence {
+  generation: string;
+  previousGeneration: string;
+  nextGeneration: string;
+  knownConsumption: number;
+  coverageMs: number;
+  crossedReset: boolean;
+  isLowerBound: boolean;
+  capacityConstrained: boolean;
+}
+
+export interface UsageObservation {
+  id: string;
+  accountKey: string;
+  fromAt: number;
+  toAt: number;
+  sourceVersion: string;
+  weekly: WindowUsageEvidence | null;
+  short: WindowUsageEvidence | null;
+}
+
+export interface DemandDay {
+  dateKey: string;
+  weeklyCost: number | null;
+  weeklyCoverage: number;
+  weeklyComplete: boolean;
+  weeklyLowerBound: boolean;
+  shortCost: number | null;
+  shortCoverage: number;
+  shortComplete: boolean;
+  shortLowerBound: boolean;
+  crossedReset: boolean;
+  weeklyCrossedReset: boolean;
+  shortCrossedReset: boolean;
+  estimated: boolean;
+  weeklyEstimated: boolean;
+  shortEstimated: boolean;
+  capacityConstrained: boolean;
+}
+
+const timestamp = (value: string | number): number => typeof value === "number" ? value : Date.parse(value);
+
+const validSnapshot = (snapshot: SnapshotV3): boolean =>
+  typeof snapshot.id === "string" && snapshot.id.length > 0 &&
+  typeof snapshot.accountKey === "string" && snapshot.accountKey.length > 0 &&
+  Number.isFinite(timestamp(snapshot.observedAt)) &&
+  [snapshot.weekly, snapshot.short].some((window) => window != null);
+
+function windowEvidence(
+  previous: WindowSnapshotV3 | null,
+  next: WindowSnapshotV3 | null,
+  duration: number,
+): WindowUsageEvidence | null {
+  if (previous == null || next == null ||
+      !Number.isFinite(previous.usedPercent) || !Number.isFinite(next.usedPercent) ||
+      previous.usedPercent < 0 || next.usedPercent < 0 || previous.usedPercent > 100 || next.usedPercent > 100 ||
+      !previous.generation || !next.generation) return null;
+  const crossedReset = previous.generation !== next.generation || next.usedPercent < previous.usedPercent;
+  const capacityConstrained = previous.usedPercent >= 100 || next.usedPercent >= 100;
+  return {
+    generation: previous.generation === next.generation ? previous.generation : `${previous.generation}->${next.generation}`,
+    previousGeneration: previous.generation,
+    nextGeneration: next.generation,
+    // A rollover hides usage before the new generation; never turn its net drop into a negative cost.
+    knownConsumption: crossedReset ? 0 : Math.max(0, next.usedPercent - previous.usedPercent),
+    coverageMs: duration,
+    crossedReset,
+    isLowerBound: crossedReset || capacityConstrained,
+    capacityConstrained,
+  };
+}
+
+export function buildUsageObservations(
+  snapshots: readonly SnapshotV3[],
+  maxGapMs = DEFAULT_MAX_OBSERVATION_GAP_MS,
+): UsageObservation[] {
+  const byAccount = new Map<string, SnapshotV3[]>();
+  for (const snapshot of snapshots) {
+    if (!validSnapshot(snapshot)) continue;
+    const accountRows = byAccount.get(snapshot.accountKey) ?? [];
+    accountRows.push(snapshot);
+    byAccount.set(snapshot.accountKey, accountRows);
+  }
+  const result: UsageObservation[] = [];
+  for (const [accountKey, rows] of byAccount) {
+    rows.sort((a, b) => timestamp(a.observedAt) - timestamp(b.observedAt) || a.id.localeCompare(b.id));
+    for (let index = 1; index < rows.length; index += 1) {
+      const previous = rows[index - 1]!, next = rows[index]!;
+      const fromAt = timestamp(previous.observedAt), toAt = timestamp(next.observedAt);
+      const duration = toAt - fromAt;
+      if (duration <= 0 || duration > maxGapMs) continue;
+      const weekly = windowEvidence(previous.weekly, next.weekly, duration);
+      const short = windowEvidence(previous.short, next.short, duration);
+      if (weekly == null && short == null) continue;
+      result.push({ id: `${accountKey}:${previous.id}:${next.id}`, accountKey,
+        fromAt, toAt,
+        sourceVersion: next.sourceVersion,
+        weekly, short });
+    }
+  }
+  return result.sort((a, b) => a.fromAt - b.fromAt || a.accountKey.localeCompare(b.accountKey));
+}
+
+interface MutableWindowDay {
+  cost: number;
+  coverageMs: number;
+  lowerBound: boolean;
+  crossedReset: boolean;
+  capacityConstrained: boolean;
+  estimated: boolean;
+  generations: Set<string>;
+  ranges: Array<{ from: number; to: number }>;
+}
+
+function newWindowDay(): MutableWindowDay {
+  return { cost: 0, coverageMs: 0, lowerBound: false, crossedReset: false,
+    capacityConstrained: false, estimated: false, generations: new Set(), ranges: [] };
+}
+
+function addWindowEvidence(
+  days: Map<number, { weekly: MutableWindowDay; short: MutableWindowDay }>,
+  observation: UsageObservation,
+  evidence: WindowUsageEvidence | null,
+  kind: "weekly" | "short",
+): void {
+  if (evidence == null) return;
+  const duration = observation.toAt - observation.fromAt;
+  if (duration <= 0) return;
+  let dayStart = beijingDayFloor(observation.fromAt);
+  while (dayStart < observation.toAt) {
+    const dayEnd = dayStart + DAY_MS;
+    const overlap = Math.max(0, Math.min(dayEnd, observation.toAt) - Math.max(dayStart, observation.fromAt));
+    if (overlap > 0) {
+      let day = days.get(dayStart);
+      if (!day) { day = { weekly: newWindowDay(), short: newWindowDay() }; days.set(dayStart, day); }
+      const target = day[kind];
+      target.cost += evidence.knownConsumption * overlap / duration;
+      target.coverageMs += overlap;
+      target.lowerBound ||= evidence.isLowerBound;
+      target.crossedReset ||= evidence.crossedReset;
+      target.capacityConstrained ||= evidence.capacityConstrained;
+      target.estimated ||= observation.fromAt < dayStart || observation.toAt > dayEnd;
+      target.generations.add(evidence.generation);
+      target.ranges.push({ from: Math.max(dayStart, observation.fromAt), to: Math.min(dayEnd, observation.toAt) });
+    }
+    dayStart = dayEnd;
+  }
+}
+
+function dayComplete(window: MutableWindowDay): boolean {
+  if (window.coverageMs !== DAY_MS || window.crossedReset || window.lowerBound || window.capacityConstrained || window.generations.size !== 1) return false;
+  const sorted = [...window.ranges].sort((a, b) => a.from - b.from);
+  let cursor = sorted[0]?.from;
+  if (cursor == null) return false;
+  const start = cursor;
+  for (const range of sorted) {
+    if (range.from > cursor) return false;
+    cursor = Math.max(cursor, range.to);
+  }
+  return start === sorted[0]!.from && cursor - start === DAY_MS && start === beijingDayFloor(start);
+}
+
+export function aggregateUsageDays(observations: readonly UsageObservation[], cutoff: number): DemandDay[] {
+  if (!Number.isFinite(cutoff)) return [];
+  const days = new Map<number, { weekly: MutableWindowDay; short: MutableWindowDay }>();
+  for (const observation of observations) {
+    if (observation.toAt > cutoff) continue;
+    addWindowEvidence(days, observation, observation.weekly, "weekly");
+    addWindowEvidence(days, observation, observation.short, "short");
+  }
+  const todayStart = beijingDayFloor(cutoff);
+  return [...days.entries()].filter(([start]) => start < todayStart).sort(([a], [b]) => a - b).map(([start, windows]) => {
+    const weeklyComplete = dayComplete(windows.weekly);
+    const shortComplete = dayComplete(windows.short);
+    return {
+      dateKey: beijingDayKey(start),
+      weeklyCost: windows.weekly.coverageMs > 0 ? windows.weekly.cost : null,
+      weeklyCoverage: Math.min(1, windows.weekly.coverageMs / DAY_MS),
+      weeklyComplete,
+      weeklyLowerBound: windows.weekly.lowerBound || windows.weekly.capacityConstrained,
+      shortCost: windows.short.coverageMs > 0 ? windows.short.cost : null,
+      shortCoverage: Math.min(1, windows.short.coverageMs / DAY_MS),
+      shortComplete,
+      shortLowerBound: windows.short.lowerBound || windows.short.capacityConstrained,
+      // Legacy aggregate quality fields describe weekly demand. A short-window
+      // re-anchor is common and must not invalidate otherwise complete weekly evidence.
+      crossedReset: windows.weekly.crossedReset,
+      weeklyCrossedReset: windows.weekly.crossedReset,
+      shortCrossedReset: windows.short.crossedReset,
+      estimated: windows.weekly.estimated,
+      weeklyEstimated: windows.weekly.estimated,
+      shortEstimated: windows.short.estimated,
+      capacityConstrained: windows.weekly.capacityConstrained || windows.short.capacityConstrained,
+    };
+  });
+}
diff --git a/src/lib/v3/planning.ts b/src/lib/v3/planning.ts
new file mode 100644
index 0000000..66cd34a
--- /dev/null
+++ b/src/lib/v3/planning.ts
