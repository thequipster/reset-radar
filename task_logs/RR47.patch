diff --git a/src/ui/usePersonalInputs.ts b/src/ui/usePersonalInputs.ts
new file mode 100644
index 0000000..436d10c
--- /dev/null
+++ b/src/ui/usePersonalInputs.ts
@@ -0,0 +1,155 @@
+// RR47 本地个人输入 hook：账号键严格分仓，null 账号仅落到独立 demo 键。
+// 只记录用户确认的行为；本 hook 不调用真实用卡命令。
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import {
+  appendCardVersion, beijingDateKey, cardReminders, createResetCard, emptyPersonalInputs,
+  personalInputsStorageKey, reconcileCardCount, recordCardUse, recordPreferenceFeedback, updateCardExpiry, updateCardState, withPersonalInputChange,
+  type CardEntryPrecision, type CardReconciliation, type CardReconciliationResult, type CardReminder, type ResetCardState,
+  type PersonalInputsData, type PersonalInputVersion, type PersonalPreference, type PreferenceFeedback,
+  type WorkloadLevel,
+} from "../lib/v3/cards";
+
+function loadInputs(accountKey: string | null): PersonalInputsData {
+  const empty = emptyPersonalInputs(accountKey);
+  if (typeof window === "undefined") return empty;
+  try {
+    const raw = window.localStorage.getItem(personalInputsStorageKey(accountKey));
+    if (raw == null) return empty;
+    const parsed = JSON.parse(raw) as Partial<PersonalInputsData>;
+    if (parsed.schema !== empty.schema || parsed.accountKey !== accountKey) return empty;
+    return {
+      ...empty,
+      ...parsed,
+      cards: Array.isArray(parsed.cards) ? parsed.cards : [],
+      cardVersions: Array.isArray(parsed.cardVersions) ? parsed.cardVersions : [],
+      useRecords: Array.isArray(parsed.useRecords) ? parsed.useRecords : [],
+      inputVersions: Array.isArray(parsed.inputVersions) ? parsed.inputVersions : [],
+      usualViewTimes: Array.isArray(parsed.usualViewTimes) ? parsed.usualViewTimes : [...empty.usualViewTimes],
+    } as PersonalInputsData;
+  } catch {
+    return empty;
+  }
+}
+
+export interface PersonalInputsState extends PersonalInputsData {
+  /** Server account count is authoritative and never persisted as a personal estimate. */
+  accountCount: number | null;
+  reconciliation: CardReconciliationResult;
+  reminders: CardReminder[];
+  effectiveWorkloadToday: WorkloadLevel | null;
+  effectiveWeeklyBudgetPercent: number | null;
+}
+
+export interface PersonalInputsController {
+  state: PersonalInputsState;
+  addCard(label: string, enteredExpiry: string | null, precision: CardEntryPrecision): void;
+  updateExpiry(localId: string, enteredExpiry: string | null, precision: CardEntryPrecision): void;
+  recordUse(localId: string): void;
+  markUnresolved(localId: string): void;
+  confirmAbsent(localId: string): void;
+  restoreAvailable(localId: string): void;
+  setWorkloadToday(level: WorkloadLevel | null): void;
+  setPreference(preference: PersonalPreference | null): void;
+  setUsualViewTimes(times: string[], confirmed: boolean): void;
+  setWeeklyBudgetPercent(value: number | null): void;
+  recordFeedback(choice: PreferenceFeedback): void;
+}
+
+export function usePersonalInputs(
+  accountKey: string | null, accountCount: number | null, now: number,
+  onChange?: (inputs: PersonalInputsState) => void,
+): PersonalInputsController {
+  const [data, setData] = useState<PersonalInputsData>(() => loadInputs(accountKey));
+  const keyRef = useRef(accountKey);
+  const onChangeRef = useRef(onChange);
+  onChangeRef.current = onChange;
+  const idSequence = useRef(0);
+
+  useEffect(() => {
+    if (keyRef.current === accountKey) return;
+    keyRef.current = accountKey;
+    const next = loadInputs(accountKey);
+    setData(next);
+  }, [accountKey]);
+
+  useEffect(() => {
+    if (data.accountKey !== accountKey || typeof window === "undefined") return;
+    try { window.localStorage.setItem(personalInputsStorageKey(accountKey), JSON.stringify(data)); } catch { /* private mode: session remains usable */ }
+  }, [data, accountKey]);
+
+  const updateInput = useCallback(<K extends PersonalInputVersion["field"]>(field: K, value: PersonalInputsData[K]) => {
+    setData((previous) => withPersonalInputChange(previous, field, value, now));
+  }, [now]);
+
+  const addCard = useCallback((label: string, enteredExpiry: string | null, precision: CardEntryPrecision) => {
+    const cleanLabel = label.trim();
+    if (cleanLabel === "") throw new Error("请给这张卡填写名称");
+    const localId = `card-${now}-${++idSequence.current}`;
+    const card = createResetCard({ localId, label: cleanLabel, enteredExpiry, entryPrecision: precision, now });
+    setData((previous) => ({
+      ...previous,
+      cards: [...previous.cards, card],
+      cardVersions: appendCardVersion(previous.cardVersions, localId, null, card, now),
+    }));
+  }, [now]);
+
+  const updateExpiry = useCallback((localId: string, enteredExpiry: string | null, precision: CardEntryPrecision) => {
+    setData((previous) => {
+      const result = updateCardExpiry(previous.cards, previous.cardVersions, localId, enteredExpiry, precision, now);
+      return { ...previous, ...result };
+    });
+  }, [now]);
+
+  const recordUse = useCallback((localId: string) => {
+    setData((previous) => recordCardUse(previous, localId, now, accountCount));
+  }, [now, accountCount]);
+
+  const markUnresolved = useCallback((localId: string) => {
+    setData((previous) => updateCardState(previous, localId, "unresolved", "unverified", now));
+  }, [now]);
+
+  const confirmAbsent = useCallback((localId: string) => {
+    setData((previous) => updateCardState(previous, localId, "unresolved", "consistent", now));
+  }, [now]);
+
+  const restoreAvailable = useCallback((localId: string) => {
+    setData((previous) => updateCardState(previous, localId, "available", "unverified", now));
+  }, [now]);
+
+  const setWorkloadToday = useCallback((level: WorkloadLevel | null) => {
+    updateInput("workloadToday", level == null ? null : { localDate: beijingDateKey(now), level });
+  }, [now, updateInput]);
+  const setPreference = useCallback((preference: PersonalPreference | null) => updateInput("preference", preference), [updateInput]);
+  const setUsualViewTimes = useCallback((times: string[], confirmed: boolean) => {
+    setData((previous) => {
+      const withTimes = withPersonalInputChange(previous, "usualViewTimes", times, now);
+      return withPersonalInputChange(withTimes, "viewTimesConfirmed", confirmed, now);
+    });
+  }, [now]);
+  const setWeeklyBudgetPercent = useCallback((value: number | null) => {
+    if (value != null && (!Number.isFinite(value) || value < 0)) return;
+    updateInput("weeklyBudgetPercent", value == null ? null : { localDate: beijingDateKey(now), value });
+  }, [updateInput]);
+  const recordFeedback = useCallback((choice: PreferenceFeedback) => {
+    setData((previous) => recordPreferenceFeedback(previous, choice, now));
+  }, [now]);
+
+  const isCurrentAccount = data.accountKey === accountKey;
+  const activeData = isCurrentAccount ? data : emptyPersonalInputs(accountKey);
+  const reconciliation = useMemo(() => reconcileCardCount(activeData.cards, accountCount), [activeData.cards, accountCount]);
+  const reminders = useMemo(() => cardReminders(activeData.cards, now, activeData.usualViewTimes, activeData.viewTimesConfirmed),
+    [activeData.cards, now, activeData.usualViewTimes, activeData.viewTimesConfirmed]);
+  const todayKey = beijingDateKey(now);
+  const effectiveWorkloadToday = activeData.workloadToday?.localDate === todayKey ? activeData.workloadToday.level : null;
+  const effectiveWeeklyBudgetPercent = activeData.weeklyBudgetPercent?.localDate === todayKey ? activeData.weeklyBudgetPercent.value : null;
+  const state = useMemo<PersonalInputsState>(() => ({
+    ...activeData, accountKey, accountCount, reconciliation, reminders, effectiveWorkloadToday, effectiveWeeklyBudgetPercent,
+  }), [activeData, accountKey, accountCount, reconciliation, reminders, effectiveWorkloadToday, effectiveWeeklyBudgetPercent]);
+
+  useEffect(() => { onChangeRef.current?.(state); }, [state]);
+
+  return {
+    state, addCard, updateExpiry, recordUse, markUnresolved, confirmAbsent, restoreAvailable, setWorkloadToday,
+    setPreference, setUsualViewTimes, setWeeklyBudgetPercent, recordFeedback,
+  };
+}
diff --git a/src/ui/useV3Journal.ts b/src/ui/useV3Journal.ts
new file mode 100644
index 0000000..338c72a
--- /dev/null
+++ b/src/ui/useV3Journal.ts
@@ -0,0 +1,173 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { invoke } from "@tauri-apps/api/core";
+import { buildUsageObservations, type SnapshotV3, type UsageObservation } from "../lib/v3/observations";
+import { freezePlanning, freezePrediction, nextSignalVersion, predictionGroupAt, type PlanningJournalRecord, type PredictionRecordV3 } from "../lib/v3/journal";
+import type { ProviderSnapshot } from "./types";
+import type { ResetStatusSnapshot } from "../lib/resetStatus";
+
+type LogRead = { path: string; content: string };
+type AppendResult = "appended" | "conflict" | "busy";
+
+export function normalizeProviderSnapshotV3(snapshot: ProviderSnapshot): SnapshotV3 | null {
+  const accountKey = snapshot.accountKey;
+  const observedAt = snapshot.rateLimitSnapshot?.observedAt ?? snapshot.updatedAt;
+  if (!accountKey || !Number.isFinite(Date.parse(observedAt))) return null;
+  const toWindow = (window: ProviderSnapshot["weeklyWindow"]): SnapshotV3["weekly"] =>
+    window?.resetsAt && Number.isFinite(Date.parse(window.resetsAt)) && Number.isFinite(window.remainingPercent)
+      ? { generation: window.resetsAt, usedPercent: Math.max(0, Math.min(100, 100 - window.remainingPercent)) }
+      : null;
+  return {
+    id: `v3-${accountKey}-${observedAt}`,
+    observedAt,
+    accountKey,
+    sourceVersion: `${snapshot.provider}:${snapshot.rateLimitSnapshot?.source ?? "provider"}`,
+    weekly: toWindow(snapshot.weeklyWindow),
+    short: toWindow(snapshot.shortWindow),
+    schemaVersion: 3,
+    rawSnapshot: snapshot,
+  };
+}
+
+async function read(kind: "usage" | "cards"): Promise<LogRead> {
+  return invoke<LogRead>("read_observation_log", { kind });
+}
+
+async function appendOnce(kind: "usage" | "cards", row: { id: string; observedAt: string; [key: string]: unknown }): Promise<string> {
+  for (let attempt = 0; attempt < 3; attempt += 1) {
+    const log = await read(kind);
+    if (log.content.split(/\r?\n/).some((line) => {
+      try { return JSON.parse(line).id === row.id; } catch { return false; }
+    })) return log.content;
+    const result = await invoke<AppendResult>("append_observation_log", {
+      kind, expectedContent: log.content, line: JSON.stringify(row),
+    });
+    if (result === "appended") return `${log.content}${log.content && !log.content.endsWith("\n") ? "\n" : ""}${JSON.stringify(row)}\n`;
+    if (result === "busy") throw new Error("观测日志正在写入，请稍后重试");
+  }
+  throw new Error("观测日志更新冲突，请稍后重试");
+}
+
+export function useV3Journal(snapshot: ProviderSnapshot | null, enabled: boolean) {
+  const [observations, setObservations] = useState<UsageObservation[]>([]);
+  const [signalHistory, setSignalHistory] = useState<PlatformSignalHistory[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const activeAccount = useRef<string | null>(snapshot?.accountKey ?? null);
+  const writer = useRef<Promise<unknown>>(Promise.resolve());
+  const enqueueWrite = useCallback(<T,>(operation: () => Promise<T>): Promise<T> => {
+    const result = writer.current.catch(() => undefined).then(operation);
+    writer.current = result;
+    return result;
+  }, []);
+
+  const refresh = useCallback(async (accountKey: string | null = activeAccount.current) => {
+    const log = await read("usage");
+    const snapshots: SnapshotV3[] = [];
+    for (const line of log.content.split(/\r?\n/)) {
+      try {
+        const row = JSON.parse(line) as SnapshotV3;
+        // Old observations.jsonl records retain their meaning and are never
+        // mistaken for v3 snapshots merely because their fields look similar.
+        if (row?.schemaVersion === 3 && row.rawSnapshot && typeof row.id === "string" && typeof row.observedAt === "string" && typeof row.accountKey === "string") snapshots.push(row);
+      } catch { /* tolerate a damaged JSONL row */ }
+    }
+    if (activeAccount.current === accountKey) setObservations(
+      accountKey == null ? [] : buildUsageObservations(snapshots.filter((row) => row.accountKey === accountKey)),
+    );
+    const cardLog = await read("cards");
+    setSignalHistory(readSignalHistory(cardLog.content));
+  }, []);
+
+  const appendSnapshot = useCallback(async (input: ProviderSnapshot) => {
+    const row = normalizeProviderSnapshotV3(input);
+    if (!row) return;
+    await enqueueWrite(() => appendOnce("usage", { ...row, observedAt: new Date(Date.parse(String(row.observedAt))).toISOString() }));
+    await refresh(input.accountKey ?? null);
+  }, [enqueueWrite, refresh]);
+
+  const appendSignals = useCallback(async (input: ProviderSnapshot) => {
+    const status = input.resetStatus;
+    if (!status || input.status !== "ok" || status.status !== "ok" || !status.fetchedAt) return;
+    const observedAt = status.fetchedAt;
+    if (!Number.isFinite(Date.parse(observedAt))) return;
+    const currentValues = [status.scheduledReset ?? null, status.activeWatch ?? null] as const;
+    const signalKinds = ["scheduled_reset", "active_watch"] as const;
+    await enqueueWrite(async () => {
+      const history = readSignalHistory((await read("cards")).content);
+      // A repeated/stale provider cache is not a newly observed signal version.
+      if (history.some((entry) => entry.observedAt === observedAt)) return;
+      for (let i = 0; i < signalKinds.length; i += 1) {
+        const signalKind = signalKinds[i]!;
+        const value = currentValues[i];
+        const prior = history.filter((entry) => entry.signalKind === signalKind).at(-1);
+        const version = nextSignalVersion(prior ?? null, value, observedAt);
+        if (!version) continue;
+        const row = { id: `signal-${signalKind}-${observedAt}-${encodeURIComponent(JSON.stringify(value))}`,
+          ...version, kind: "platform_signal", signalKind };
+        await appendOnce("cards", row);
+        history.push(row as PlatformSignalHistory);
+      }
+    });
+    await refresh(input.accountKey ?? null);
+  }, [enqueueWrite, refresh]);
+
+  const appendPrediction = useCallback(async (input: PredictionRecordV3) => {
+    const record = freezePrediction(input);
+    const observedAt = new Date(record.issuedAt).toISOString();
+    const scheduledGroup = predictionGroupAt(record.issuedAt, false);
+    await enqueueWrite(async () => {
+      const log = await read("cards");
+      const alreadyPrimary = scheduledGroup.groupDate != null && log.content.split(/\r?\n/).some((line) => {
+        try {
+          const row = JSON.parse(line);
+          return row.group === "primary_daily" && row.groupDate === scheduledGroup.groupDate &&
+            row.record?.target === record.target && row.record?.modelVersion === record.modelVersion;
+        } catch { return false; }
+      });
+      const grouping = predictionGroupAt(record.issuedAt, alreadyPrimary);
+      return appendOnce("cards", { id: record.id, observedAt, kind: "prediction", ...grouping, record });
+    });
+  }, [enqueueWrite]);
+
+  const appendPlanning = useCallback(async (input: PlanningJournalRecord) => {
+    const record = freezePlanning(input);
+    await enqueueWrite(() => appendOnce("cards", { id: record.id, observedAt: new Date().toISOString(), kind: "planning", record }));
+  }, [enqueueWrite]);
+
+  useEffect(() => {
+    activeAccount.current = snapshot?.accountKey ?? null;
+    if (!enabled) { setObservations([]); setError(null); return; }
+    let alive = true;
+    void (async () => {
+      try {
+        if (snapshot?.status === "ok") { await appendSnapshot(snapshot); await appendSignals(snapshot); }
+        else await refresh(snapshot?.accountKey ?? null);
+        if (alive) setError(null);
+      } catch (cause) { if (alive) setError(String(cause)); }
+    })();
+    return () => { alive = false; };
+  }, [enabled, snapshot?.updatedAt, snapshot?.accountKey, appendSnapshot, appendSignals, refresh]);
+
+  return { observations, signalHistory, error, refresh, appendSnapshot, appendPrediction, appendPlanning };
+}
+
+export interface PlatformSignalHistory {
+  signalKind: "scheduled_reset" | "active_watch";
+  observedAt: string;
+  firstSeenAt: string;
+  change: "first_seen" | "changed" | "cancelled";
+  value: ResetStatusSnapshot["scheduledReset"] | ResetStatusSnapshot["activeWatch"];
+}
+
+function readSignalHistory(content: string): PlatformSignalHistory[] {
+  const rows: PlatformSignalHistory[] = [];
+  for (const line of content.split(/\r?\n/)) {
+    try {
+      const row = JSON.parse(line);
+      if (row?.kind === "platform_signal" &&
+          ["scheduled_reset", "active_watch"].includes(row.signalKind) &&
+          typeof row.observedAt === "string" && typeof row.firstSeenAt === "string" &&
+          ["first_seen", "changed", "cancelled"].includes(row.change)) rows.push(row as PlatformSignalHistory);
+    } catch { /* tolerate damaged historical JSONL rows */ }
+  }
+  return rows.sort((a, b) => Date.parse(a.observedAt) - Date.parse(b.observedAt));
+}
diff --git a/src/ui/useV3Planning.ts b/src/ui/useV3Planning.ts
