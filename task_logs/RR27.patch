+/* 键盘焦点可见（02-spec §4/§5：visible focus 不被 hover 替代）。 */
+:focus-visible {
+  outline: 2px solid var(--accent-blue-bright);
+  outline-offset: 1px;
+}
+
+/* 共享动效；reduced-motion 下取消位移/旋转/闪烁（02-spec §5）。 */
+@keyframes rr-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@keyframes rr-fade-in {
+  from {
+    opacity: 0;
+    transform: translateY(4px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+.rr-spin {
+  animation: rr-spin 0.9s linear infinite;
+}
+
+.rr-fade-in {
+  animation: rr-fade-in 180ms ease-out;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .rr-spin {
+    animation: none;
+  }
+  .rr-fade-in {
+    animation: none;
+  }
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+  }
+}
