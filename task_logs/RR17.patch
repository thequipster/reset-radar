diff --git a/src/lib/calibrationSnapshot.ts b/src/lib/calibrationSnapshot.ts
new file mode 100644
index 0000000..2939d95
--- /dev/null
+++ b/src/lib/calibrationSnapshot.ts
@@ -0,0 +1,28 @@
+// RR17：自动对答案的可序列化纯核心产物；文件IO由脚本/Rust承接。
+import { assessHistorySource, selectQuotaResetHistory } from "./history.ts";
+import { scorePredictions, type PredictionOutcome } from "./calibration.ts";
+import { selectCompletedPredictionWindows } from "./calibrationWindows.ts";
+import { compareWatchPredictions } from "./watchCalibration.ts";
+import type { PredictionRecord } from "./predictions.ts";
+
+export function buildCalibrationSnapshot(history: unknown, rows: readonly PredictionRecord[], generatedAt: Date) {
+  const source = assessHistorySource(history, generatedAt);
+  const document = history as { events?: unknown[]; upstream?: { pagination?: { has_more?: boolean } } } | null;
+  const resetTimes = selectQuotaResetHistory(Array.isArray(document?.events) ? document.events : []);
+  // API分页可能截断早期事件：只在最早已返回regular之后判定无重置，不能猜未覆盖的旧窗口。
+  const coverageStart = document?.upstream?.pagination?.has_more === false ? null : resetTimes.at(-1) ?? "invalid";
+  const asOf = new Date(source.state === "invalid" ? NaN : source.asOf!);
+  const selection = selectCompletedPredictionWindows(rows, resetTimes, asOf, coverageStart);
+  const outcomes: PredictionOutcome[] = selection.windows.map(({ dateKey, predictedPercent, realized }) => ({ dateKey, predictedPercent, realized }));
+  return {
+    schema: "reset-radar/calibration@1" as const,
+    generatedAt: Number.isFinite(generatedAt.getTime()) ? generatedAt.toISOString() : null,
+    state: source.state,
+    historySource: source,
+    coverageStart: coverageStart === "invalid" ? null : coverageStart,
+    excluded: selection.excluded,
+    score: scorePredictions(outcomes),
+    watchComparison: compareWatchPredictions(rows, resetTimes, asOf, coverageStart),
+    outcomes: selection.windows.map(({ row: _row, ...window }) => window),
+  };
+}
diff --git a/src/lib/calibrationWindows.ts b/src/lib/calibrationWindows.ts
new file mode 100644
index 0000000..3ff14c4
--- /dev/null
+++ b/src/lib/calibrationWindows.ts
@@ -0,0 +1,53 @@
+// RR17：风险模型唯一目标为未来24h（risk.ts），不能用同一北京日代替。
+// 日键只用于每天选首条与分周，实际结果采用精确的(start,end]窗口。
+import { beijingCalendarDateKey } from "./resetCard.ts";
+import { RESET_RISK_HORIZON_MS } from "./risk.ts";
+import { parseIsoWithZone } from "./watchSignal.ts";
+import type { PredictionLogRow } from "./calibration.ts";
+
+export type WindowExclusion = "legacy" | "invalid" | "late" | "pending" | "outside-history" | "duplicate";
+export interface CompletedPredictionWindow {
+  row: PredictionLogRow;
+  dateKey: string;
+  windowStart: string;
+  windowEnd: string;
+  predictedPercent: number;
+  realized: boolean;
+}
+
+/** 文件顺序仅作同刻平局决胜；先按实际记录时刻选择合法的同日首行，再判断窗口覆盖。 */
+export function selectCompletedPredictionWindows(
+  rows: readonly PredictionLogRow[], announcedAt: readonly string[], asOf: Date,
+  coverageStart: string | null = null,
+): { windows: CompletedPredictionWindow[]; excluded: Record<WindowExclusion, number> } {
+  const excluded: Record<WindowExclusion, number> = { legacy: 0, invalid: 0, late: 0, pending: 0, "outside-history": 0, duplicate: 0 };
+  const asOfMs = asOf.getTime();
+  const lowerBound = coverageStart === null ? null : parseIsoWithZone(coverageStart)?.timestamp;
+  const valid: { row: PredictionLogRow; start: number; end: number; recorded: number; index: number }[] = [];
+  for (const [index, row] of rows.entries()) {
+    if (row?.windowStart === undefined && row?.windowEnd === undefined) { excluded.legacy++; continue; }
+    const start = parseIsoWithZone(row?.windowStart)?.timestamp;
+    const end = parseIsoWithZone(row?.windowEnd)?.timestamp;
+    const recorded = parseIsoWithZone(row?.fetchedAt)?.timestamp;
+    if (!Number.isFinite(asOfMs) || start === undefined || end === undefined || recorded === undefined
+      || typeof row?.date !== "string" || beijingCalendarDateKey(start) !== row.date
+      || end - start !== RESET_RISK_HORIZON_MS || !Number.isFinite(row.predictedRisk)
+      || row.predictedRisk < 0 || row.predictedRisk > 100) { excluded.invalid++; continue; }
+    if (recorded > start) { excluded.late++; continue; }
+    valid.push({ row, start, end, recorded, index });
+  }
+  valid.sort((a, b) => a.recorded - b.recorded || a.index - b.index);
+  const resetTimes = announcedAt.map((v) => parseIsoWithZone(v)?.timestamp).filter((v): v is number => v !== undefined && v <= asOfMs);
+  const selected = new Set<string>();
+  const windows: CompletedPredictionWindow[] = [];
+  for (const { row, start, end } of valid) {
+    if (selected.has(row.date)) { excluded.duplicate++; continue; }
+    selected.add(row.date);
+    if (end > asOfMs) { excluded.pending++; continue; }
+    if (lowerBound === undefined || (lowerBound !== null && start < lowerBound)) { excluded["outside-history"]++; continue; }
+    windows.push({ row, dateKey: row.date, windowStart: new Date(start).toISOString(), windowEnd: new Date(end).toISOString(),
+      predictedPercent: row.predictedRisk, realized: resetTimes.some((event) => event > start && event <= end) });
+  }
+  windows.sort((a, b) => a.dateKey.localeCompare(b.dateKey));
+  return { windows, excluded };
+}
diff --git a/src/lib/historyPrediction.ts b/src/lib/historyPrediction.ts
new file mode 100644
index 0000000..155a614
--- /dev/null
+++ b/src/lib/historyPrediction.ts
@@ -0,0 +1,15 @@
+// RR17：CLI预测以本次评估时刻开启24h窗口；旧历史只提供模型输入，不能充当预测时刻。
+import { assessHistorySource, selectQuotaResetHistory } from "./history.ts";
+import { assessWatchSignal } from "./watchSignal.ts";
+import { assessResetRisk } from "./risk.ts";
+import { buildPredictionRecord } from "./predictions.ts";
+
+export function buildHistoryPrediction(history: unknown, evaluatedAt: Date) {
+  const source = assessHistorySource(history, evaluatedAt);
+  if (source.state !== "fresh") return null;
+  const document = history as { events: unknown[]; status?: { active_watch?: unknown } };
+  const watch = assessWatchSignal(document.status?.active_watch, evaluatedAt);
+  const risk = assessResetRisk(selectQuotaResetHistory(document.events), evaluatedAt, watch.percent ?? undefined);
+  return buildPredictionRecord({ risk, evaluatedAt: evaluatedAt.toISOString(), recordedAt: evaluatedAt,
+    quotaStatus: "ok", resetSourceState: null });
+}
