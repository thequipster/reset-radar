+    expect(risk.effectiveExposureDays).toBeCloseTo(30, 6);
+    expect(risk.unexpectedEventCount).toBe(2);
+    expect(risk.quality.dataRange.from).toBe(T0 - 12 * DAY);
+    expect(risk.scope).toBe("account");
